<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration «windows-installer» (CODE_SIGNING.md): the NSIS installer built from the signed
     programs. desktop-release.yml uploads it as a ZIP with the one installer at its root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*-setup.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
