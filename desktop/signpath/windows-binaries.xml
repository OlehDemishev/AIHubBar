<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration «windows-binaries» (CODE_SIGNING.md): the app's three programs, signed before
     they go into the installer. desktop-release.yml uploads them as one ZIP with these names at its root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="AIHubBar.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="claudepult.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="claudepult-hook.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
