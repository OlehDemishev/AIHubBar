{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Hub Bar",
  "mainBinaryName": "AIHubBar",
  "version": "0.1.3",
  "identifier": "com.demishev.claudepult",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Claude Code limits, sessions and projects in the tray",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "Ukrainian",
          "German",
          "French",
          "Spanish",
          "PortugueseBR",
          "Italian",
          "Polish",
          "Japanese",
          "Korean",
          "Indonesian",
          "Arabic"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "claudepult"
        ],
        "name": "AI Hub Bar settings",
        "description": "AI Hub Bar settings and profiles",
        "mimeType": "application/x-claudepult",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMTI1NDA1NkMwNjQxNEYKUldSUFFRWnNCVlFTVUZFOFAwaEtFWDkvK0JBMW5ZVTl3cXZaL21jdmRIWmw4eEM4VGVMVmh4YzIK",
      "endpoints": [
        "https://github.com/OlehDemishev/AIHubBar/releases/download/desktop-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
