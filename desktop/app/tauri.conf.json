{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Hub Bar",
  "mainBinaryName": "AIHubBar",
  "version": "0.1.0",
  "identifier": "com.demishev.claudepult",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Claude Code limits, sessions and projects in the tray",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian", "Ukrainian", "German", "French", "Spanish", "PortugueseBR", "Italian", "Polish", "Japanese", "Korean", "Indonesian", "Arabic"],
        "displayLanguageSelector": false
      }
    }
  }
}
