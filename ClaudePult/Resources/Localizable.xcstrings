    "Удалить сборки и кэши, сбросить симуляторы (с подтверждением).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف ملفات البناء والذاكرة المؤقتة وإعادة ضبط المحاكيات (مع التأكيد)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds und Caches löschen, Simulatoren zurücksetzen (mit Bestätigung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete builds and caches, reset simulators (with confirmation)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar builds y cachés, restablecer los simuladores (con confirmación)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les builds et les caches, réinitialiser les simulateurs (avec confirmation)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus build dan cache, atur ulang simulator (dengan konfirmasi)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare build e cache, reimpostare i simulatori (con conferma)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドとキャッシュを削除し、シミュレーターをリセット (確認あり)。"
