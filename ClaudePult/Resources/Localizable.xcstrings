    "Токен берётся из базы настроек Cursor только для запроса расхода и нигде не сохраняется": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُؤخذ الرمز من قاعدة إعدادات Cursor لطلب الاستهلاك فقط ولا يُحفظ في أي مكان"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token wird nur für die Verbrauchsabfrage aus der Einstellungsdatenbank von Cursor gelesen und nirgends gespeichert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is taken from Cursor's settings database only for the usage request and isn't stored anywhere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se toma de la base de ajustes de Cursor solo para consultar el gasto y no se guarda en ningún sitio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton est lu dans la base de réglages de Cursor uniquement pour la requête de dépenses et n'est enregistré nulle part"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token diambil dari basis data pengaturan Cursor hanya untuk permintaan penggunaan dan tidak disimpan di mana pun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il token viene letto dal database delle impostazioni di Cursor solo per la richiesta dei consumi e non viene salvato da nessuna parte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンは利用額の問い合わせのためだけに Cursor の設定データベースから取得し、どこにも保存しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 사용량 조회에만 Cursor 설정 데이터베이스에서 가져오며 어디에도 저장하지 않습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Token jest pobierany z bazy ustawień Cursor tylko do zapytania o wydatki i nigdzie nie jest zapisywany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O token é lido do banco de configurações do Cursor só para consultar o gasto e não é salvo em lugar nenhum"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен береться з бази налаштувань Cursor лише для запиту витрат і ніде не зберігається"
          }
        }
      }
    },
