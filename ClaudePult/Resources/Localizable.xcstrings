    "Запустить в фоне ночью; утром придёт сводка": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيل في الخلفية الليلة؛ يصل ملخص صباحًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute Nacht im Hintergrund ausführen; morgens kommt eine Zusammenfassung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run in the background tonight; a summary comes in the morning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar en segundo plano esta noche; por la mañana llega un resumen"
          }
