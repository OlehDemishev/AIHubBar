    "«%@» запустится в фоне в %@, после сброса лимита.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبدأ «%@» في الخلفية في %@ بعد إعادة ضبط الحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ startet um %@ im Hintergrund, nachdem das Limit zurückgesetzt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will start in the background at %@, after the limit resets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se iniciará en segundo plano a las %@, después de reiniciarse el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» démarrera en arrière-plan à %@, après la réinitialisation de la limite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» akan mulai di latar belakang pukul %@, setelah batas direset."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» partirà in background alle %@, dopo l'azzeramento del limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は制限のリセット後、%@ にバックグラウンドで開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»은(는) 한도가 초기화된 뒤 %@에 백그라운드로 시작됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” uruchomi się w tle o %@, po zresetowaniu limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» vai começar em segundo plano às %@, depois que o limite reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@» запустится в фоне в %2$@, после сброса лимита."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» запуститься у фоні о %@, після скидання ліміту."
          }
        }
      }
    },
    "«%@» запущен в новом окне Терминала.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ «%@» في نافذة طرفية جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ in einem neuen Terminal-Fenster gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” started in a new Terminal window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» iniciado en una nueva ventana de Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» lancé dans une nouvelle fenêtre de Terminal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» dimulai di jendela Terminal baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» avviato in una nuova finestra del Terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を新しいターミナルウィンドウで開始しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»을(를) 새 터미널 창에서 시작했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” uruchomiono w nowym oknie Terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» iniciado em uma nova janela do Terminal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» запущено в новому вікні Термінала."
          }
        }
      }
    },
    "«%@» запущен в фоне (лимит %lld мин). Итог придёт уведомлением.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ «%@» في الخلفية (الحد %lld د). ستصل النتيجة بإشعار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ im Hintergrund gestartet (Limit %lld min). Das Ergebnis kommt als Mitteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” started in the background (limit %lld min). The result comes as a notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» iniciado en segundo plano (límite %lld min). El resultado llegará como notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» lancé en arrière-plan (limite %lld min). Le résultat arrivera par notification."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» dimulai di latar belakang (batas %lld mnt). Hasilnya datang lewat pemberitahuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» avviato in background (limite %lld min). Il risultato arriverà con una notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をバックグラウンドで開始しました (制限 %lld 分)。結果は通知で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»을(를) 백그라운드로 시작했습니다 (제한 %lld분). 결과는 알림으로 옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” uruchomiono w tle (limit %lld min). Wynik przyjdzie w powiadomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» iniciado em segundo plano (limite %lld min). O resultado chegará por notificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@» запущен в фоне (лимит %2$lld мин). Итог придёт уведомлением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» запущено у фоні (ліміт %lld хв). Підсумок прийде сповіщенням."
          }
        }
      }
    },
    "«Ближайшее» берёт даты из проектов-папок: включите «Проекты» с папками.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأخذ «القريب» التواريخ من مشاريع المجلدات: فعّل «المشاريع» مع المجلدات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Demnächst“ nimmt die Daten aus Ordner-Projekten: „Projekte“ mit Ordnern einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«Upcoming» takes its dates from folder projects: turn on «Projects» with folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Próximo» toma las fechas de los proyectos-carpeta: activa «Proyectos» con carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«À venir» prend ses dates dans les projets-dossiers : activez «Projets» avec des dossiers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mendatang» mengambil tanggal dari proyek folder: aktifkan «Proyek» dengan folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«In arrivo» prende le date dai progetti-cartella: attiva «Progetti» con le cartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今後の予定」 はフォルダのプロジェクトから日付を取ります: フォルダで 「プロジェクト」 をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«다가오는 일정»은 폴더 프로젝트에서 날짜를 가져옵니다: 폴더로 «프로젝트»를 켜세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Najbliższe» bierze daty z projektów-folderów: włącz «Projekty» z folderami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Próximos» pega as datas dos projetos-pasta: ative «Projetos» com pastas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Найближче» бере дати з проєктів-папок: увімкніть «Проєкти» з папками."
          }
        }
      }
    },
    "«Готово» добавит профиль и сделает его текущим. Дальше всё правится в Настройках → «Профили».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«تم» يضيف ملف التعريف ويجعله الحالي. وبعدها يُعدَّل كل شيء من الإعدادات ← «ملفات التعريف»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Fertig“ fügt das Profil hinzu und macht es aktiv. Alles Weitere lässt sich unter Einstellungen → „Profile“ ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Done” adds the profile and makes it current. Everything can be changed later in Settings → “Profiles”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Listo» añade el perfil y lo convierte en el actual. Después todo se cambia en Ajustes → «Perfiles»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Terminé» ajoute le profil et le rend actif. Ensuite, tout se règle dans Réglages → «Profils»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«Selesai» menambahkan profil dan menjadikannya aktif. Selanjutnya semua diubah di Pengaturan → «Profil»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Fine» aggiunge il profilo e lo rende attivo. Tutto il resto si cambia in Impostazioni → «Profili»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「完了」でプロファイルを追加して現在のプロファイルにします。あとは設定 → 「プロファイル」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«완료»를 누르면 프로필이 추가되어 현재 프로필이 됩니다. 이후에는 설정 → «프로필»에서 모두 바꿀 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Gotowe” dodaje profil i ustawia go jako bieżący. Resztę zmienisz w Ustawieniach → „Profile”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Pronto» adiciona o perfil e o torna atual. Depois tudo se ajusta em Ajustes → «Perfis»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Готово» додасть профіль і зробить його поточним. Далі все змінюється в Налаштуваннях → «Профілі»."
          }
        }
      }
    },
    "«Лимиты Claude» для рабочего стола: правый клик по столу → «Изменить виджеты…» → ClaudePult. Маленький — кольцо сессии, средний — сессия и неделя.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«حدود Claude» لسطح المكتب: انقر بزر الفأرة الأيمن على سطح المكتب ← «تحرير الأدوات…» ← ClaudePult. الصغيرة — حلقة الجلسة، المتوسطة — الجلسة والأسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Claude-Limits“ für den Schreibtisch: Rechtsklick auf den Schreibtisch → „Widgets bearbeiten…“ → ClaudePult. Klein — der Sitzungsring, mittel — Sitzung und Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Claude Limits” for the desktop: right-click the desktop → “Edit Widgets…” → ClaudePult. Small — the session ring, medium — session and week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Límites de Claude» para el escritorio: clic derecho en el escritorio → «Editar widgets…» → ClaudePult. Pequeño — el anillo de la sesión, mediano — sesión y semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Limites de Claude» pour le bureau : clic droit sur le bureau → «Modifier les widgets…» → ClaudePult. Petit — l'anneau de la session, moyen — session et semaine."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«Batas Claude» untuk desktop: klik kanan desktop → «Edit Widget…» → ClaudePult. Kecil — cincin sesi, sedang — sesi dan minggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Limiti di Claude» per la scrivania: clic destro sulla scrivania → «Modifica widget…» → ClaudePult. Piccolo — l'anello della sessione, medio — sessione e settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ用の「Claude の制限」: デスクトップを右クリック → 「ウィジェットを編集…」 → ClaudePult。小 — セッションのリング、中 — セッションと週。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱용 «Claude 한도»: 데스크톱을 오른쪽 클릭 → «위젯 편집…» → ClaudePult. 작은 크기 — 세션 링, 중간 크기 — 세션과 주간."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Limity Claude” na biurko: kliknij biurko prawym przyciskiem → „Edytuj widżety…” → ClaudePult. Mały — pierścień sesji, średni — sesja i tydzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Limites do Claude» para a mesa: clique direito na mesa → «Editar Widgets…» → ClaudePult. Pequeno — o anel da sessão, médio — sessão e semana."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ліміти Claude» для робочого столу: правий клік по столу → «Змінити віджети…» → ClaudePult. Малий — кільце сесії, середній — сесія і тиждень."
          }
        }
      }
    },
    "«Минимум» — значок и события, «Лимиты» — ещё проценты сессии и недели, «Всё» — всё, что есть. Отдельные элементы — в Настройках → «Строка меню». Набор общий для всех профилей.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«الحد الأدنى» — الأيقونة والأحداث، «الحدود» — مع نسب الجلسة والأسبوع، «الكل» — كل ما هو متاح. العناصر المفردة — من الإعدادات ← «شريط القائمة». المجموعة مشتركة بين كل ملفات التعريف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Minimum“ — Symbol und Ereignisse, „Limits“ — dazu Prozente von Sitzung und Woche, „Alles“ — alles, was es gibt. Einzelne Elemente — unter Einstellungen → „Menüleiste“. Die Auswahl gilt für alle Profile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Minimum” — the icon and events, “Limits” — plus session and week percentages, “Everything” — all there is. Single elements — in Settings → “Menu Bar”. The set is shared by all profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mínimo» — el icono y los eventos, «Límites» — además los porcentajes de sesión y semana, «Todo» — todo lo que hay. Los elementos sueltos, en Ajustes → «Barra de menús». El conjunto es común a todos los perfiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Minimum» — l'icône et les événements, «Limites» — plus les pourcentages de session et de semaine, «Tout» — tout ce qui existe. Les éléments un par un, dans Réglages → «Barre des menus». L'ensemble est commun à tous les profils."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«Minimum» — ikon dan peristiwa, «Batas» — ditambah persentase sesi dan minggu, «Semua» — semua yang ada. Elemen satu per satu — di Pengaturan → «Bar Menu». Set ini berlaku untuk semua profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Minimo» — l'icona e gli eventi, «Limiti» — più le percentuali di sessione e settimana, «Tutto» — tutto quello che c'è. I singoli elementi — in Impostazioni → «Barra dei menu». La selezione vale per tutti i profili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最小」 — アイコンとイベント、「制限」 — セッションと週の使用率も、「すべて」 — あるものすべて。個別の要素は設定 → 「メニューバー」で。この組み合わせはすべてのプロファイルで共通です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«최소» — 아이콘과 이벤트, «한도» — 세션과 주간 사용률 추가, «전체» — 있는 것 모두. 개별 요소는 설정 → «메뉴 막대»에서. 이 구성은 모든 프로필에 공통입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Minimum” — ikona i zdarzenia, „Limity” — do tego procenty sesji i tygodnia, „Wszystko” — wszystko, co jest. Pojedyncze elementy — w Ustawieniach → „Pasek menu”. Zestaw jest wspólny dla wszystkich profili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mínimo» — o ícone e os eventos, «Limites» — mais os percentuais de sessão e semana, «Tudo» — tudo o que há. Elementos avulsos, em Ajustes → «Barra de menus». O conjunto é comum a todos os perfis."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мінімум» — значок і події, «Ліміти» — ще відсотки сесії й тижня, «Усе» — усе, що є. Окремі елементи — в Налаштуваннях → «Рядок меню». Набір спільний для всіх профілів."
          }
        }
      }
    },
    "«Минимум» — значок, проблемы и ожидающие ответа. «Лимиты» — ещё сессия и неделя. «Всё» — всё, что есть. Любая правка ниже делает набор «Своим».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«الحد الأدنى» — الأيقونة والمشكلات والجلسات المنتظرة للرد. «الحدود» — مع الجلسة والأسبوع. «الكل» — كل ما هو متاح. أي تعديل أدناه يجعل المجموعة «مخصّصة»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Minimum“ — Symbol, Probleme und wartende Sitzungen. „Limits“ — dazu Sitzung und Woche. „Alles“ — alles, was es gibt. Jede Änderung unten macht die Auswahl zu „Eigene“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Minimum” — the icon, problems and sessions waiting for an answer. “Limits” — plus session and week. “Everything” — all there is. Any change below makes the set “Custom”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mínimo» — el icono, los problemas y las sesiones que esperan respuesta. «Límites» — además sesión y semana. «Todo» — todo lo que hay. Cualquier cambio abajo convierte el conjunto en «Propio»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Minimum» — l'icône, les problèmes et les sessions en attente de réponse. «Limites» — plus session et semaine. «Tout» — tout ce qui existe. Toute modification ci-dessous rend l'ensemble «Personnalisé»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«Minimum» — ikon, masalah, dan sesi yang menunggu jawaban. «Batas» — ditambah sesi dan minggu. «Semua» — semua yang ada. Perubahan apa pun di bawah menjadikan set «Kustom»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Minimo» — l'icona, i problemi e le sessioni in attesa di risposta. «Limiti» — più sessione e settimana. «Tutto» — tutto quello che c'è. Qualsiasi modifica qui sotto rende la selezione «Personale»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最小」 — アイコン、問題、応答待ちのセッション。「制限」 — セッションと週も。「すべて」 — あるものすべて。下で何か変えると組み合わせは「カスタム」になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«최소» — 아이콘, 문제, 응답을 기다리는 세션. «한도» — 세션과 주간 추가. «전체» — 있는 것 모두. 아래에서 무엇이든 바꾸면 구성이 «사용자 지정»이 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Minimum” — ikona, problemy i sesje czekające na odpowiedź. „Limity” — do tego sesja i tydzień. „Wszystko” — wszystko, co jest. Każda zmiana poniżej zmienia zestaw na „Własny”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mínimo» — o ícone, os problemas e as sessões aguardando resposta. «Limites» — mais sessão e semana. «Tudo» — tudo o que há. Qualquer alteração abaixo torna o conjunto «Personalizado»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мінімум» — значок, проблеми й ті, хто чекає на відповідь. «Ліміти» — ще сесія і тиждень. «Усе» — усе, що є. Будь-яка зміна нижче робить набір «Своїм»."
          }
        }
      }
    },
    "«Только файлы»: читать и писать внутри папки проекта, без терминала и интернета": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«الملفات فقط»: القراءة والكتابة داخل مجلد المشروع، دون طرفية أو إنترنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur Dateien“: im Projektordner lesen und schreiben, kein Terminal, kein Internet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Files only”: read and write inside the project folder, no terminal and no internet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo archivos»: leer y escribir dentro de la carpeta del proyecto, sin terminal ni internet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Fichiers uniquement» : lire et écrire dans le dossier du projet, sans terminal ni internet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«Hanya berkas»: baca dan tulis di dalam folder proyek, tanpa terminal dan internet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo file»: leggere e scrivere nella cartella del progetto, niente terminale né internet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイルのみ」: プロジェクトフォルダー内での読み書き、ターミナルとインターネットなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«파일만»: 프로젝트 폴더 안에서만 읽고 쓰기, 터미널과 인터넷 없음"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Tylko pliki”: czytanie i zapis w folderze projektu, bez terminala i internetu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Só arquivos»: ler e escrever dentro da pasta do projeto, sem terminal nem internet"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Лише файли»: читати й писати всередині папки проєкту, без термінала та інтернету"
          }
        }
      }
    },
    "«Фон» запускает claude -p без окна: разрешены чтение и правка файлов проекта, проверки и сборки, git без push в main и без force, gh pr create/view/list; остальное отклоняется. Итог — уведомлением и в Telegram.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«الخلفية» تشغّل claude -p دون نافذة: يُسمح بقراءة ملفات المشروع وتعديلها، والفحوصات والبناء، وgit دون push إلى main ودون force، وgh pr create/view/list؛ ويُرفض ما سوى ذلك. تصل النتيجة بإشعار وفي Telegram."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Hintergrund“ startet claude -p ohne Fenster: Projektdateien lesen und bearbeiten, Prüfungen und Builds, git ohne Push auf main und ohne force, gh pr create/view/list sind erlaubt; alles andere wird abgelehnt. Das Ergebnis kommt als Mitteilung und an Telegram."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Background” runs claude -p without a window: reading and editing project files, checks and builds, git without pushing to main and without force, gh pr create/view/list are allowed; everything else is refused. The result comes as a notification and to Telegram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Segundo plano» ejecuta claude -p sin ventana: se permite leer y editar archivos del proyecto, comprobaciones y builds, git sin push a main ni force, gh pr create/view/list; lo demás se rechaza. El resultado llega por notificación y por Telegram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Arrière-plan» lance claude -p sans fenêtre : lecture et modification des fichiers du projet, vérifications et builds, git sans push sur main ni force, gh pr create/view/list sont autorisés ; le reste est refusé. Le résultat arrive par notification et sur Telegram."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«Latar belakang» menjalankan claude -p tanpa jendela: membaca dan mengedit berkas proyek, pemeriksaan dan build, git tanpa push ke main dan tanpa force, gh pr create/view/list diizinkan; selebihnya ditolak. Hasil datang lewat pemberitahuan dan Telegram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Background» esegue claude -p senza finestra: sono consentiti lettura e modifica dei file del progetto, controlli e build, git senza push su main né force, gh pr create/view/list; il resto viene rifiutato. Il risultato arriva con una notifica e su Telegram."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「バックグラウンド」はウィンドウなしで claude -p を実行します: プロジェクトファイルの読み取りと編集、チェックとビルド、main への push と force を除く git、gh pr create/view/list を許可し、それ以外は拒否します。結果は通知と Telegram で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«백그라운드»는 창 없이 claude -p를 실행합니다: 프로젝트 파일 읽기와 편집, 검사와 빌드, main으로의 push와 force를 제외한 git, gh pr create/view/list는 허용되고 나머지는 거부됩니다. 결과는 알림과 Telegram으로 옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„W tle” uruchamia claude -p bez okna: dozwolone są czytanie i edycja plików projektu, kontrole i buildy, git bez push do main i bez force, gh pr create/view/list; reszta jest odrzucana. Wynik przychodzi w powiadomieniu i na Telegramie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Segundo plano» roda claude -p sem janela: são permitidos ler e editar arquivos do projeto, verificações e builds, git sem push na main e sem force, gh pr create/view/list; o resto é recusado. O resultado chega por notificação e no Telegram."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Фон» запускає claude -p без вікна: дозволено читання й зміну файлів проєкту, перевірки й збирання, git без push у main і без force, gh pr create/view/list; решта відхиляється. Підсумок — сповіщенням і в Telegram."
          }
        }
      }
    },
