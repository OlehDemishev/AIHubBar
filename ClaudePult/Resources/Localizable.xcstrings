        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесію використано на %@%@. Фонове завдання може впертися в ліміт."
          }
        }
      }
    },
    "Сессия с обратным отсчётом до сброса и прогнозом по темпу за 30 мин, неделя, недели по моделям, extra usage.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلسة مع عدّ تنازلي لإعادة الضبط وتوقّع بحسب وتيرة آخر 30 د، والأسبوع، والأسابيع حسب النموذج، وextra usage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung mit Countdown bis zur Zurücksetzung und Prognose nach dem Tempo der letzten 30 min, die Woche, Wochen nach Modell, Extra usage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session with a countdown to the reset and a forecast from the last 30 min, the week, weeks per model, extra usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión con cuenta atrás hasta el reinicio y previsión según el ritmo de los últimos 30 min, la semana, semanas por modelo, extra usage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session avec un compte à rebours avant la réinitialisation et une prévision selon le rythme des 30 dernières minutes, la semaine, les semaines par modèle, extra usage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi dengan hitung mundur ke reset dan prakiraan berdasarkan laju 30 mnt terakhir, minggu, minggu per model, extra usage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione con conto alla rovescia fino all'azzeramento e previsione in base al ritmo degli ultimi 30 min, la settimana, le settimane per modello, extra usage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットまでのカウントダウンと直近 30 分のペースによる予測付きのセッション、週、モデル別の週、extra usage。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기화까지 카운트다운과 최근 30분 속도에 따른 예측이 있는 세션, 주간, 모델별 주간, extra usage."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja z odliczaniem do resetu i prognozą według tempa z ostatnich 30 min, tydzień, tygodnie według modeli, extra usage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão com contagem até o reinício e previsão pelo ritmo dos últimos 30 min, a semana, semanas por modelo, extra usage."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесія з відліком до скидання і прогнозом за темпом за 30 хв, тиждень, тижні за моделями, extra usage."
          }
        }
      }
    },
