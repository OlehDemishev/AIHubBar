    "Уведомления ClaudePult выключены в macOS — «ждёт ответа», итоги задач и лимиты не приходят.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات ClaudePult متوقفة في macOS — لا تصل «بانتظار رد» ولا نتائج المهام ولا الحدود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ClaudePult-Mitteilungen sind in macOS aus — „wartet“, Aufgabenergebnisse und Limits kommen nicht an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClaudePult notifications are off in macOS — “waiting”, task results and limits do not arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de ClaudePult están desactivadas en macOS — «espera respuesta», los resultados de tareas y los límites no llegan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de ClaudePult sont désactivées dans macOS — «attend une réponse», les résultats des tâches et les limites n'arrivent pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan ClaudePult dimatikan di macOS — «menunggu», hasil tugas, dan batas tidak sampai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di ClaudePult sono disattivate in macOS — «in attesa», i risultati delle attività e i limiti non arrivano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ClaudePult の通知が macOS でオフです — 「応答待ち」、タスクの結果、制限が届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 ClaudePult 알림이 꺼져 있습니다 — «응답 대기», 작업 결과, 한도가 오지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia ClaudePult są wyłączone w macOS — „czeka na odpowiedź”, wyniki zadań i limity nie dochodzą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações do ClaudePult estão desativadas no macOS — «aguardando resposta», os resultados das tarefas e os limites não chegam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення ClaudePult вимкнено в macOS — «чекає на відповідь», підсумки завдань і ліміти не приходять."
          }
        }
      }
    },
