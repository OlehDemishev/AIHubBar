            "value": "Puoi farlo anche più tardi, nelle Impostazioni e nella finestra Aiuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはあとから「設定」や「ヘルプ」ウインドウでも行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모든 것은 나중에 설정과 도움말 창에서도 할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
