    "macOS сообщает о критической нехватке памяти. Закройте лишние приложения.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبلغ macOS عن نقص حاد في الذاكرة. أغلق التطبيقات غير الضرورية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS meldet kritischen Speichermangel. Beenden Sie nicht benötigte Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS reports a critical memory shortage. Quit the apps you don't need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS informa de una falta crítica de memoria. Cierra las apps que no necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS signale un manque critique de mémoire. Fermez les apps inutiles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS melaporkan kekurangan memori kritis. Tutup aplikasi yang tidak perlu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS segnala una carenza critica di memoria. Chiudi le app che non servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がメモリの深刻な不足を報告しています。不要なアプリを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 심각한 메모리 부족을 알립니다. 필요 없는 앱을 종료하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zgłasza krytyczny brak pamięci. Zamknij niepotrzebne aplikacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS informa falta crítica de memória. Feche os apps desnecessários."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS повідомляє про критичну нестачу пам’яті. Закрийте зайві застосунки."
          }
        }
      }
    },
