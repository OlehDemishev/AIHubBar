    "Процессор, память, диск, сеть, батарея и самые прожорливые приложения; уведомления о нагрузке, памяти, месте и заряде.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعالج والذاكرة والقرص والشبكة والبطارية والتطبيقات الأكثر استهلاكًا؛ تنبيهات الحمل والذاكرة والمساحة والشحن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozessor, Speicher, Festplatte, Netzwerk, Akku und die hungrigsten Apps; Hinweise zu Last, Speicher, Platz und Akku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor, memory, disk, network, battery and the hungriest apps; alerts about load, memory, space and charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesador, memoria, disco, red, batería y las apps que más consumen; avisos de carga, memoria, espacio y batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur, mémoire, disque, réseau, batterie et les apps les plus gourmandes ; alertes de charge, mémoire, espace et batterie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosesor, memori, disk, jaringan, baterai, dan aplikasi paling boros; peringatan beban, memori, ruang, dan daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Processore, memoria, disco, rete, batteria e le app più esigenti; avvisi su carico, memoria, spazio e carica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセッサ、メモリ、ディスク、ネットワーク、バッテリー、負荷の高いアプリ。負荷・メモリ・空き容量・残量の通知。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세서, 메모리, 디스크, 네트워크, 배터리와 가장 많이 쓰는 앱; 부하·메모리·공간·충전 알림."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesor, pamięć, dysk, sieć, bateria i najbardziej żarłoczne aplikacje; powiadomienia o obciążeniu, pamięci, miejscu i baterii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Processador, memória, disco, rede, bateria e os apps que mais consomem; alertas de carga, memória, espaço e bateria."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесор, пам’ять, диск, мережа, батарея й найненажерливіші застосунки; сповіщення про навантаження, пам’ять, місце й заряд."
          }
        }
      }
    },
