    "Найдено: %@. Лимиты подписки и список сессий работают только с Claude Code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على: %@. حدود الاشتراك وقائمة الجلسات تعمل مع Claude Code فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefunden: %@. Abo-Limits und die Sitzungsliste funktionieren nur mit Claude Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found: %@. Subscription limits and the session list work only with Claude Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado: %@. Los límites de la suscripción y la lista de sesiones solo funcionan con Claude Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvé : %@. Les limites de l’abonnement et la liste des sessions ne fonctionnent qu’avec Claude Code."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditemukan: %@. Batas langganan dan daftar sesi hanya berfungsi dengan Claude Code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovato: %@. I limiti dell’abbonamento e l’elenco delle sessioni funzionano solo con Claude Code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかりました: %@。サブスクリプションの上限とセッション一覧は Claude Code でのみ動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견됨: %@. 구독 한도와 세션 목록은 Claude Code에서만 작동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
