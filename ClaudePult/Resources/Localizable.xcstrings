          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prazos e publicações de projeto.md, linhas de plano-de-conteudo.md — nos perfis com o calendário ativado (Ajustes → «Perfis»)."
          }
        },
        "uk": {
          "stringUnit": {
