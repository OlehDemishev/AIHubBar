    "Так выглядит строка, когда есть что показать.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا يبدو العنصر عندما يكون هناك ما يُعرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sieht das Element aus, wenn es etwas zu zeigen gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the item when there is something to show."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así se ve el elemento cuando hay algo que mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici l'élément quand il y a quelque chose à montrer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Begini tampilan item saat ada yang ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così appare l'elemento quando c'è qualcosa da mostrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する内容があるときの見た目です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보여 줄 것이 있을 때의 모습입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak wygląda element, gdy jest co pokazać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim fica o item quando há algo para mostrar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так виглядає рядок, коли є що показати."
          }
        }
      }
    },
    "Так строка выглядит сейчас. Пустые элементы (0, нет данных) не показываются.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا يبدو العنصر الآن. العناصر الفارغة (0، لا بيانات) لا تظهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sieht das Element jetzt aus. Leere Elemente (0, keine Daten) werden nicht gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the item right now. Empty elements (0, no data) are not shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así se ve el elemento ahora. Los elementos vacíos (0, sin datos) no se muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici l'élément maintenant. Les éléments vides (0, pas de données) ne s'affichent pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Begini tampilan item sekarang. Elemen kosong (0, tanpa data) tidak ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così appare l'elemento adesso. Gli elementi vuoti (0, nessun dato) non vengono mostrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の見た目です。空の要素 (0、データなし) は表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금의 모습입니다. 빈 요소 (0, 데이터 없음)는 보이지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak wygląda element teraz. Puste elementy (0, brak danych) nie są pokazywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim está o item agora. Elementos vazios (0, sem dados) não aparecem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так рядок виглядає зараз. Порожні елементи (0, немає даних) не показуються."
          }
        }
      }
    },
