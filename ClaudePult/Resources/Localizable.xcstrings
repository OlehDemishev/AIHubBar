    "Для Code Assist и платных ключей API. Бесплатный вход и Google AI Pro/Ultra с июня 2026 — в Antigravity CLI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لـ Code Assist ومفاتيح API المدفوعة. انتقل الدخول المجاني وGoogle AI Pro/Ultra إلى Antigravity CLI في يونيو 2026."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Code Assist und bezahlte API-Schlüssel. Die kostenlose Anmeldung und Google AI Pro/Ultra sind im Juni 2026 zu Antigravity CLI gewechselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Code Assist and paid API keys. Free sign-in and Google AI Pro/Ultra moved to Antigravity CLI in June 2026."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Code Assist y claves de API de pago. El acceso gratuito y Google AI Pro/Ultra pasaron a Antigravity CLI en junio de 2026."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour Code Assist et les clés d'API payantes. La connexion gratuite et Google AI Pro/Ultra sont passés à Antigravity CLI en juin 2026."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk Code Assist dan kunci API berbayar. Login gratis dan Google AI Pro/Ultra pindah ke Antigravity CLI pada Juni 2026."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Code Assist e chiavi API a pagamento. L'accesso gratuito e Google AI Pro/Ultra sono passati ad Antigravity CLI a giugno 2026."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Code Assist と有料 API キー向け。無料ログインと Google AI Pro/Ultra は 2026 年 6 月に Antigravity CLI へ移りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Code Assist와 유료 API 키용. 무료 로그인과 Google AI Pro/Ultra는 2026년 6월에 Antigravity CLI로 옮겨 갔습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla Code Assist i płatnych kluczy API. Darmowe logowanie oraz Google AI Pro/Ultra przeszły w czerwcu 2026 do Antigravity CLI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Code Assist e chaves de API pagas. O acesso gratuito e o Google AI Pro/Ultra passaram para o Antigravity CLI em junho de 2026."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Code Assist і платних ключів API. Безплатний вхід і Google AI Pro/Ultra з червня 2026 — в Antigravity CLI."
          }
        }
      }
    },
