          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "claude -p senza finestra: solo azioni consentite, risultato con una notifica e su Telegram"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
