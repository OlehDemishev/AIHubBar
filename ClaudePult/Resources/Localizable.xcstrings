          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi per script si chiamano così: %@ --sessions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプト用コマンドの呼び出し方: %@ --sessions"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트 명령은 이렇게 호출합니다: %@ --sessions"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
