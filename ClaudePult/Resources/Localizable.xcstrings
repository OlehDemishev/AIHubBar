    "Сессия и неделя подписки Claude, прогноз, расход по проектам и по API.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة وأسبوع اشتراك Claude، والتوقّع، والاستهلاك حسب المشروع وإنفاق API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung und Woche des Claude-Abos, Prognose, Verbrauch nach Projekt und API-Kosten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude subscription session and week, forecast, usage by project and API spend."
          }
        },
        "es": {
