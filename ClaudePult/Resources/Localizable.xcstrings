    "Сессии Claude Code на этом Маке и фоновые задачи. Нужны hooks — вкладка «Claude Code».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسات Claude Code على هذا الـMac والمهام الخلفية. تحتاج إلى hooks — علامة التبويب «Claude Code»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-Code-Sitzungen auf diesem Mac und Hintergrundaufgaben. Braucht Hooks — Tab „Claude Code“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code sessions on this Mac and background runs. Needs hooks — the “Claude Code” tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones de Claude Code en este Mac y tareas en segundo plano. Necesita hooks: pestaña «Claude Code»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions Claude Code sur ce Mac et tâches en arrière-plan. Nécessite les hooks — onglet « Claude Code »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
