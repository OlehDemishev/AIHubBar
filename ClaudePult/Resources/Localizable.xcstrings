    "Сессии Claude Code на этом Маке и фоновые задачи. Нужны hooks — вкладка «Claude Code».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسات Claude Code على هذا الـMac والمهام الخلفية. تحتاج إلى hooks — علامة التبويب «Claude Code»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-Code-Sitzungen auf diesem Mac und Hintergrundaufgaben. Braucht Hooks — Tab „Claude Code“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code sessions on this Mac and background runs. Needs hooks — the “Claude Code” tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones de Claude Code en este Mac y tareas en segundo plano. Necesita hooks: pestaña «Claude Code»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions Claude Code sur ce Mac et tâches en arrière-plan. Nécessite les hooks — onglet « Claude Code »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Claude Code di Mac ini dan tugas latar belakang. Perlu hooks — tab «Claude Code»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessioni di Claude Code su questo Mac e attività in background. Servono gli hooks — scheda «Claude Code»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の Claude Code セッションとバックグラウンドタスク。hooks が必要です —「Claude Code」タブ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 Claude Code 세션과 백그라운드 작업. hooks가 필요합니다 — «Claude Code» 탭."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje Claude Code na tym Macu i zadania w tle. Potrzebne hooks — karta «Claude Code»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões do Claude Code neste Mac e tarefas em segundo plano. Precisa de hooks — aba «Claude Code»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесії Claude Code на цьому Маку й фонові задачі. Потрібні hooks — вкладка «Claude Code»."
          }
        }
      }
    },
    "Сессии Claude не отслеживаются: hooks не установлены.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسات Claude غير متتبَّعة: hooks غير مثبّتة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-Sitzungen werden nicht verfolgt: Hooks sind nicht installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude sessions are not tracked: hooks are not installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones de Claude no se siguen: los hooks no están instalados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions Claude ne sont pas suivies : les hooks ne sont pas installés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Claude tidak dipantau: hook belum terpasang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni di Claude non sono seguite: gli hook non sono installati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude のセッションは追跡されていません: hooks がインストールされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 세션을 추적하지 않습니다: hooks가 설치되어 있지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje Claude nie są śledzone: hooki nie są zainstalowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões do Claude não são acompanhadas: os hooks não estão instalados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесії Claude не відстежуються: hooks не встановлено."
          }
        }
      }
