    "Не выбрана модель — Настройки → «Сервисы AI» → «Проверить»": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُختر نموذج — الإعدادات ← «خدمات الذكاء الاصطناعي» ← «تحقّق»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell gewählt — Einstellungen → „KI-Dienste“ → „Prüfen“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model chosen — Settings → “AI Services” → “Check”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay modelo elegido — Ajustes → «Servicios de IA» → «Comprobar»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle choisi — Réglages → «Services d'IA» → «Vérifier»"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada model dipilih — Pengaturan → «Layanan AI» → «Periksa»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello scelto — Impostazioni → «Servizi IA» → «Verifica»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが選ばれていません — 設定 → 「AI サービス」 → 「確認」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 고르지 않았습니다 — 설정 → «AI 서비스» → «확인»"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano modelu — Ustawienia → „Usługi AI” → „Sprawdź”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo escolhido — Ajustes → «Serviços de IA» → «Verificar»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вибрано модель — Налаштування → «Сервіси AI» → «Перевірити»"
          }
        }
      }
    },
    "Не гасить и экран": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء الشاشة أيضًا مضاءة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch den Bildschirm anlassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the display on too"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener también la pantalla encendida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder aussi l’écran allumé"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan layar tetap menyala"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni acceso anche lo schermo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面もオフにしない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면도 켜 두기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wygaszaj też ekranu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter a tela ligada também"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не гасити й екран"
          }
        }
      }
    },
    "Не давать Mac засыпать, пока не выключите": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء الـMac مستيقظًا حتى تُطفئ ذلك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Mac wach halten, bis Sie ausschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the Mac awake until you switch this off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el Mac despierto hasta que lo apagues"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le Mac éveillé jusqu’à désactivation"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga Mac tetap terjaga sampai dimatikan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni sveglio il Mac finché non lo spegni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするまで Mac をスリープさせない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌 때까지 Mac을 깨어 있게 유지"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie usypiaj Maca, dopóki nie wyłączysz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter o Mac acordado até você desligar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давати Mac засинати, доки не вимкнете"
          }
        }
      }
    },
    "Не давать Mac засыпать: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء Mac مستيقظًا: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac wach halten: %@"
