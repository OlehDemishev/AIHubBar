    "Строка широкая (%lld pt): на MacBook с вырезом её может закрыть вырез или скрыть система.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item is wide (%lld pt): on a MacBook with a notch it may be covered by the notch or hidden by the system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento es ancho (%lld pt): en un MacBook con notch puede quedar tapado por el notch u ocultarlo el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
