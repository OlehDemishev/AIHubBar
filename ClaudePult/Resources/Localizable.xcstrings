    "Сейчас сон уже отключён другим приложением или командой pmset — AI Hub Bar его не трогает.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكون معطّل بالفعل من تطبيق آخر أو بأمر pmset، ولا يغيّره AI Hub Bar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ruhezustand ist schon von einer anderen App oder einem pmset-Befehl abgeschaltet; AI Hub Bar lässt das so."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep is already turned off by another app or a pmset command; AI Hub Bar leaves it alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reposo ya lo desactivó otra app o un comando pmset; AI Hub Bar no lo toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille est déjà désactivée par une autre app ou une commande pmset ; AI Hub Bar n’y touche pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidur sudah dimatikan oleh aplikasi lain atau perintah pmset; AI Hub Bar tidak mengubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stop è già disattivato da un’altra app o da un comando pmset; AI Hub Bar non lo tocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープはすでに別のアプリか pmset コマンドで無効になっています。AI Hub Bar は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기가 이미 다른 앱이나 pmset 명령으로 꺼져 있습니다. AI Hub Bar는 건드리지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usypianie jest już wyłączone przez inną aplikację lub polecenie pmset; AI Hub Bar go nie rusza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repouso já foi desligado por outro app ou um comando pmset; o AI Hub Bar não mexe nisso."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон уже вимкнено іншим застосунком або командою pmset — AI Hub Bar його не чіпає."
          }
        }
      }
    },
    "Сервер лимитов просит запрашивать реже": {
      "localizations": {
