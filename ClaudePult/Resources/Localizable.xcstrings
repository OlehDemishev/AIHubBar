    "Процессор (модуль «Ресурсы Mac»)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعالج (وحدة «موارد الـMac»)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozessor (Modul „Mac-Ressourcen“)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor («Mac Resources» module)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesador (módulo «Recursos del Mac»)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur (module « Ressources du Mac »)"
          }
        },
        "id": {
