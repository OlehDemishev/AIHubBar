    "Пустой профиль: всё выберете на следующих шагах.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف تعريف فارغ: تختار كل شيء في الخطوات التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leeres Profil: Sie wählen alles in den nächsten Schritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An empty profile: you choose everything in the next steps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil vacío: lo eliges todo en los pasos siguientes."
          }
        },
