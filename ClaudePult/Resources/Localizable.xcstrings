    "Claude": {},
    "Claude берёт первый пункт Next и делает его по правилам ~/Projects/CLAUDE.md: ветка, проверки, PR, STATUS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude takes the first Next item and does it by the rules of ~/Projects/CLAUDE.md: branch, checks, PR, STATUS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude toma el primer punto de Next y lo hace según las reglas de ~/Projects/CLAUDE.md: rama, comprobaciones, PR, STATUS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude prend le premier point de Next et le réalise selon les règles de ~/Projects/CLAUDE.md : branche, vérifications, PR, STATUS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude pega o primeiro item de Next e o faz segundo as regras de ~/Projects/CLAUDE.md: branch, verificações, PR, STATUS."
          }
        }
      }
    },
    "Claude выполняет ваш текст по тем же правилам.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude carries out your text by the same rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ejecuta tu texto con las mismas reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude exécute votre texte selon les mêmes règles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude executa seu texto com as mesmas regras."
          }
        }
      }
    },
    "Claude доводит текущую работу в папке: проверки, коммит, push, PR, STATUS — без нового кода.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude finishes the current work in the folder: checks, commit, push, PR, STATUS — no new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude termina el trabajo actual de la carpeta: comprobaciones, commit, push, PR, STATUS — sin código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude termine le travail en cours dans le dossier : vérifications, commit, push, PR, STATUS — sans nouveau code."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude conclui o trabalho atual da pasta: verificações, commit, push, PR, STATUS — sem código novo."
          }
        }
      }
    },
    "Claude ждёт ответа — %@": {
      "localizations": {
