    "У этого Mac нет крышки: правило нужно только ноутбукам.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا غطاء لهذا الـ Mac: القاعدة للحواسيب المحمولة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat keinen Deckel: Die Regel ist nur für Laptops."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no lid: the rule is only for laptops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene tapa: la regla es solo para portátiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a pas de capot : la règle ne concerne que les portables."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini tidak punya penutup: aturan ini hanya untuk laptop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non ha coperchio: la regola è solo per i portatili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac には蓋がありません。このルールはノートブック専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 덮개가 없습니다. 이 규칙은 노트북 전용입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie ma pokrywy: reguła jest tylko dla laptopów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem tampa: a regra é só para notebooks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цього Mac немає кришки: правило потрібне лише ноутбукам."
          }
        }
      }
    },
