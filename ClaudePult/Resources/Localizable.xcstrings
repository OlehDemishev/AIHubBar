    "Сервис команд-шаблонов профиля (этап 4). Агенты и ключи — Настройки → «Сервисы AI».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة أوامر ملف التعريف. الوكلاء والمفاتيح — الإعدادات ← «خدمات الذكاء الاصطناعي»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst für die Befehle des Profils. Agenten und Schlüssel — Einstellungen → „KI-Dienste“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service for the profile's command templates. Agents and keys — Settings → “AI Services”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de los comandos del perfil. Agentes y claves — Ajustes → «Servicios de IA»."
          }
        },
        "fr": {
