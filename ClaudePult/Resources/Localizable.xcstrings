    "Осталось %lld %%. Подключите зарядку.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتبقي %lld %%. وصّل الشاحن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %lld %%. Ladegerät anschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% left. Plug in the charger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda un %lld %%. Conecta el cargador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %lld %%. Branchez le chargeur."
          }
        },
        "id": {
