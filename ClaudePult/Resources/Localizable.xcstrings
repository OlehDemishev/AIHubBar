    "Команды _daily-report: отчёт, быстрая сводка, очистка сборок.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوامر _daily-report: التقرير، الملخص السريع، تنظيف البناء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "_daily-report-Befehle: Bericht, Kurzübersicht, Build-Bereinigung."
