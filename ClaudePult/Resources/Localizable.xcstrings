    "Меньше 20 ГБ — стоит запустить очистку": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل من 20 غ.ب — يستحسن تشغيل التنظيف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als 20 GB — die Bereinigung lohnt sich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than 20 GB — worth running the cleanup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de 20 GB — conviene ejecutar la limpieza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de 20 Go — il est temps de lancer le nettoyage"
          }
        },
        "id": {
