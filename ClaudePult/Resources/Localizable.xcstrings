            "value": "Nie udało się odczytać „%@”: to nie jest plik ustawień ClaudePult."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler «%@»: não é um arquivo de ajustes do ClaudePult."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати «%@»: це не файл налаштувань ClaudePult."
