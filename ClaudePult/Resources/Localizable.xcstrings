    "claude -p без окна: только разрешённые действия, итог — уведомлением и в Telegram": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "claude -p دون نافذة: الإجراءات المسموح بها فقط، والنتيجة بإشعار وفي Telegram"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "claude -p ohne Fenster: nur erlaubte Aktionen, Ergebnis als Mitteilung und an Telegram"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "claude -p without a window: allowed actions only, result as a notification and to Telegram"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "claude -p sin ventana: solo acciones permitidas, resultado por notificación y por Telegram"
