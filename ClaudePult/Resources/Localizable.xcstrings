    },
    "На паузе до сброса лимита. Продолжить сейчас": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف حتى إعادة ضبط الحد. استئناف الآن"
          }
        },
        "de": {
