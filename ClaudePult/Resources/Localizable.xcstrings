    "Объясни, что делает {файл} и где он используется в {проект}. Коротко, по-русски.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشرح ما يفعله {file} وأين يُستخدم في {project}. باختصار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkläre, was {file} macht und wo es in {project} verwendet wird. Kurz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain what {file} does and where it is used in {project}. Keep it short."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica qué hace {file} y dónde se usa en {project}. En breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique ce que fait {file} et où il est utilisé dans {project}. En bref."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan apa yang dilakukan {file} dan di mana dipakai di {project}. Singkat saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiega cosa fa {file} e dove viene usato in {project}. In breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{file} が何をしていて {project} のどこで使われているか、簡潔に説明して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{file}이(가) 무엇을 하고 {project}에서 어디에 쓰이는지 짧게 설명해 줘."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjaśnij, co robi {file} i gdzie jest używany w {project}. Krótko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique o que {file} faz e onde é usado em {project}. Em poucas palavras."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поясни, що робить {file} і де він використовується в {project}. Коротко."
          }
        }
      }
    },
