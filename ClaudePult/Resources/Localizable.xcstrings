        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer en arrière-plan cette nuit ; résumé le matin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan di latar belakang malam ini; ringkasan datang pagi hari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui in background stanotte; al mattino arriva un riepilogo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜バックグラウンドで実行し、朝に概要が届きます"
