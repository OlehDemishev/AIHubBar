    " Claude Code подхватывает изменения сам, в том числе в открытых сессиях.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " يطبّق Claude Code التغيير تلقائيًا، بما في ذلك في الجلسات المفتوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code übernimmt die Änderung selbst, auch in offenen Sitzungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code picks up the change by itself, including open sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code aplica el cambio por sí mismo, también en las sesiones abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code applique la modification tout seul, y compris dans les sessions ouvertes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code menerapkan perubahan sendiri, termasuk di sesi yang sedang terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code applica la modifica da solo, anche nelle sessioni aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code は開いているセッションも含め、変更を自動で反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code는 열려 있는 세션을 포함해 변경 사항을 스스로 반영합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code sam wprowadza zmianę, także w otwartych sesjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " O Claude Code aplica a mudança sozinho, inclusive nas sessões abertas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code підхоплює зміни сам, зокрема у відкритих сесіях."
          }
        }
      }
    },
    " Нет на этом Маке: %@ — после импорта выберите свои папки.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " غير موجود على هذا الـ Mac: %@ — اختر مجلداتك بعد الاستيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Nicht auf diesem Mac: %@ — wählen Sie nach dem Import eigene Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Not on this Mac: %@ — choose your own folders after the import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " No están en este Mac: %@ — elige tus propias carpetas después de importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Absent sur ce Mac : %@ — choisissez vos propres dossiers après l'import."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Tidak ada di Mac ini: %@ — pilih folder Anda sendiri setelah impor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Non presenti su questo Mac: %@ — dopo l'importazione scegli le tue cartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " この Mac にありません: %@ — 読み込み後に自分のフォルダーを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 이 Mac에 없음: %@ — 가져온 뒤 자신의 폴더를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Brak na tym Macu: %@ — po imporcie wybierz własne foldery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Não existem neste Mac: %@ — escolha suas pastas depois da importação."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " Немає на цьому Маку: %@ — після імпорту виберіть свої папки."
          }
        }
      }
    },
