    "Сравнений пока не было: в развёрнутом проекте включите «Сравнить», выберите сервисы и команду.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مقارنات بعد: في مشروع موسَّع فعّل «قارن»، واختر الخدمات وأمرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Vergleiche: In einem aufgeklappten Projekt „Vergleichen“ einschalten, Dienste und einen Befehl wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No comparisons yet: in an expanded project turn on “Compare”, pick services and a command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay comparaciones: en un proyecto desplegado activa «Comparar», elige servicios y un comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de comparaison : dans un projet déplié, activez «Comparer», choisissez des services et une commande."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perbandingan: di proyek yang dibuka nyalakan «Bandingkan», pilih layanan dan perintah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun confronto: in un progetto espanso attiva «Confronta», scegli i servizi e un comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ比較はありません: 開いたプロジェクトで「比較」をオンにし、サービスとコマンドを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 비교가 없습니다: 펼친 프로젝트에서 «비교»를 켜고 서비스와 명령을 고르세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie było porównań: w rozwiniętym projekcie włącz „Porównaj”, wybierz usługi i polecenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há comparações: em um projeto expandido ative «Comparar», escolha serviços e um comando."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівнянь поки не було: у розгорнутому проєкті увімкніть «Порівняти», виберіть сервіси й команду."
          }
        }
      }
    },
