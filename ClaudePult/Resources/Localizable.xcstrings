    "Даты — из проект.md (дедлайн, публикация) и контент-план.md у профилей с календарём (вкладка «Профили»).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي التواريخ من مشروع.md (الموعد النهائي، النشر) وخطة-المحتوى.md في ملفات التعريف ذات التقويم (علامة التبويب «ملفات التعريف»)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten kommen aus projekt.md (Frist, Veröffentlichung) und inhaltsplan.md der Profile mit Kalender (Tab „Profile“)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates come from project.md (deadline, publication) and content-plan.md of profiles with a calendar (the “Profiles” tab)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas vienen de proyecto.md (fecha límite, publicación) y de plan-de-contenido.md en los perfiles con calendario (pestaña «Perfiles»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates viennent de projet.md (échéance, publication) et de plan-de-contenu.md dans les profils avec calendrier (onglet «Profils»)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal diambil dari proyek.md (tenggat, publikasi) dan rencana-konten.md di profil dengan kalender (tab «Profil»)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le date vengono da progetto.md (scadenza, pubblicazione) e da piano-contenuti.md dei profili con calendario (scheda «Profili»)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付は、カレンダーを使うプロファイルの プロジェクト.md (締め切り、公開) と コンテンツ計画.md から取ります (「プロファイル」タブ)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜는 캘린더를 쓰는 프로필의 프로젝트.md (마감, 게시)와 콘텐츠-계획.md에서 가져옵니다 («프로필» 탭)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daty pochodzą z projekt.md (termin, publikacja) i plan-tresci.md w profilach z kalendarzem (karta „Profile”)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas vêm de projeto.md (prazo, publicação) e de plano-de-conteudo.md nos perfis com calendário (aba «Perfis»)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дати — з проєкт.md (дедлайн, публікація) і контент-план.md у профілів з календарем (вкладка «Профілі»)."
          }
        }
      }
    },
