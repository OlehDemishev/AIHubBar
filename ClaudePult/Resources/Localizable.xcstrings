    "Сессия использована на %@%@. Фоновая задача может упереться в лимит.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session is %@ used%@. A background task may hit the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión está usada al %@%@. La tarea en segundo plano puede chocar con el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session est utilisée à %@%@. La tâche en arrière-plan risque d'atteindre la limite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão está %@ usada%@. A tarefa em segundo plano pode bater no limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "Сессия использована на %1$@%2$@. Фоновая задача может упереться в лимит."
          }
        }
      }
    },
    "Сессия с обратным отсчётом до сброса и прогнозом по темпу за 30 мин, неделя, недели по моделям, extra usage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session with a countdown to the reset and a forecast from the last 30 min, the week, weeks per model, extra usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión con cuenta atrás hasta el reinicio y previsión según el ritmo de los últimos 30 min, la semana, semanas por modelo, extra usage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session avec un compte à rebours avant la réinitialisation et une prévision selon le rythme des 30 dernières minutes, la semaine, les semaines par modèle, extra usage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão com contagem até o reinício e previsão pelo ritmo dos últimos 30 min, a semana, semanas por modelo, extra usage."
          }
        }
      }
    },
    "Скопировать: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
