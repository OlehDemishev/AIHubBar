    "Сессия использована на %@%@. Фоновая задача может упереться в лимит.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استُخدمت الجلسة بنسبة %@%@. قد تصطدم المهمة الخلفية بالحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung ist zu %@ verbraucht%@. Eine Hintergrundaufgabe kann ans Limit stoßen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session is %@ used%@. A background task may hit the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión está usada al %@%@. La tarea en segundo plano puede chocar con el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session est utilisée à %@%@. La tâche en arrière-plan risque d'atteindre la limite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi sudah terpakai %@%@. Tugas latar belakang bisa terbentur batas."
          }
        },
        "it": {
