    "Иначе запросы считаются по журналам ~/.gemini за сегодня и делятся на дневной лимит тарифа": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وإلا تُحسب طلبات اليوم من سجلات ‎~/.gemini‎ وتُقسم على الحد اليومي للخطة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst werden die heutigen Anfragen aus den Protokollen in ~/.gemini gezählt und durch das Tageslimit des Tarifs geteilt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise today's requests are counted from the ~/.gemini logs and divided by your plan's daily limit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, las solicitudes de hoy se cuentan en los registros de ~/.gemini y se dividen por el límite diario del plan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, les requêtes du jour sont comptées dans les journaux de ~/.gemini et divisées par la limite quotidienne du forfait"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak, permintaan hari ini dihitung dari log ~/.gemini dan dibagi dengan batas harian paket"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti le richieste di oggi vengono contate dai log di ~/.gemini e divise per il limite giornaliero del piano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、今日のリクエストを ~/.gemini のログから数え、プランの1日の上限で割ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇지 않으면 오늘의 요청을 ~/.gemini 로그에서 세어 요금제의 일일 한도로 나눕니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przeciwnym razie dzisiejsze zapytania są liczone z dzienników ~/.gemini i dzielone przez dzienny limit planu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, as solicitações de hoje são contadas nos logs de ~/.gemini e divididas pelo limite diário do plano"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інакше сьогоднішні запити рахуються за журналами ~/.gemini і діляться на денний ліміт тарифу"
          }
        }
      }
    },
