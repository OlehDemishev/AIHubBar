          "stringUnit": {
            "state": "new",
            "value": "«%1$@» запустится в фоне в %2$@, после сброса лимита."
          }
        }
      }
    },
    "«%@» запущен в новом окне Терминала.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
