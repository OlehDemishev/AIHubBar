    "Внутри git-репозитории — предлагаю источник «git-репозитории».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الداخل مستودعات git — أقترح المصدر «مستودعات git»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darin sind git-Repositorys — ich schlage die Quelle „git-Repositorys“ vor."
          }
        },
