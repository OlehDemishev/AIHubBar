    "Читать и писать только внутри папки проекта. Без терминала и интернета.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القراءة والكتابة داخل مجلد المشروع فقط. دون طرفية أو إنترنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur im Projektordner lesen und schreiben. Kein Terminal, kein Internet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and write only inside the project folder. No terminal, no internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer y escribir solo dentro de la carpeta del proyecto. Sin terminal ni internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire et écrire uniquement dans le dossier du projet. Sans terminal ni internet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca dan tulis hanya di dalam folder proyek. Tanpa terminal dan internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere e scrivere solo nella cartella del progetto. Niente terminale né internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトフォルダー内だけで読み書き。ターミナルとインターネットなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 폴더 안에서만 읽고 쓰기. 터미널과 인터넷 없음."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytanie i zapis tylko w folderze projektu. Bez terminala i internetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler e escrever só dentro da pasta do projeto. Sem terminal nem internet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читати й писати лише всередині папки проєкту. Без термінала та інтернету."
          }
        }
      }
    },
    "Чтение и правка файлов, git (без push в main и удаления истории), проверки и сборки, pull request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة الملفات وتعديلها، وgit (دون push إلى main ودون حذف السجل)، والفحوصات والبناء، وpull request."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien lesen und bearbeiten, git (kein Push auf main, kein Löschen der Historie), Prüfungen und Builds, Pull Requests."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading and editing files, git (no push to main, no history removal), checks and builds, pull requests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer y editar archivos, git (sin push a main ni borrar historial), comprobaciones y builds, pull requests."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture et modification des fichiers, git (sans push sur main ni suppression d'historique), vérifications et builds, pull requests."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca dan mengedit berkas, git (tanpa push ke main dan tanpa menghapus riwayat), pemeriksaan dan build, pull request."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere e modificare file, git (niente push su main né cancellazione della cronologia), controlli e build, pull request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの読み取りと編集、git (main への push と履歴の削除はなし)、チェックとビルド、pull request。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 읽기와 편집, git (main으로 push와 기록 삭제 없음), 검사와 빌드, pull request."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytanie i edycja plików, git (bez push do main i bez usuwania historii), kontrole i buildy, pull requesty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler e editar arquivos, git (sem push na main e sem apagar histórico), verificações e builds, pull requests."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читання й правка файлів, git (без push у main і видалення історії), перевірки й збирання, pull request."
          }
        }
      }
    },
