    "На паузе до сброса лимита": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف مؤقتًا حتى إعادة ضبط الحد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert bis zum Zurücksetzen des Limits"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused until the limit resets"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa hasta el reinicio del límite"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause jusqu'à la réinitialisation"
          }
        },
