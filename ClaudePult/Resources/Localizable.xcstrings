    "Нужно разрешить AI Hub Bar в Системных настройках → Основные → Объекты входа.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب السماح لـ AI Hub Bar في إعدادات النظام ← عام ← عناصر تسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Hub Bar muss unter Systemeinstellungen → Allgemein → Anmeldeobjekte erlaubt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Hub Bar has to be allowed in System Settings → General → Login Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que permitir AI Hub Bar en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut autoriser AI Hub Bar dans Réglages Système → Général → Ouverture."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Hub Bar perlu diizinkan di Pengaturan Sistem → Umum → Item Login."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisogna consentire AI Hub Bar in Impostazioni di Sistema → Generali → Elementi login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → 一般 → ログイン項目で AI Hub Bar を許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 로그인 항목에서 AI Hub Bar를 허용해야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzeba zezwolić na AI Hub Bar w Ustawieniach systemowych → Ogólne → Rzeczy otwierane podczas logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
