        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤 백그라운드에서 실행하고 아침에 요약을 받습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom w tle w nocy; rano przyjdzie podsumowanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar em segundo plano à noite; de manhã chega um resumo"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустити у фоні вночі; зранку прийде зведення"
          }
        }
      }
    },
