    "Claude": {},
    "Claude берёт первый пункт Next и делает его по правилам ~/Projects/CLAUDE.md: ветка, проверки, PR, STATUS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأخذ Claude أول بند في Next وينفّذه وفق قواعد ~/Projects/CLAUDE.md: فرع، فحوصات، PR، STATUS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nimmt den ersten Next-Punkt und erledigt ihn nach den Regeln von ~/Projects/CLAUDE.md: Branch, Prüfungen, PR, STATUS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude takes the first Next item and does it by the rules of ~/Projects/CLAUDE.md: branch, checks, PR, STATUS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude toma el primer punto de Next y lo hace según las reglas de ~/Projects/CLAUDE.md: rama, comprobaciones, PR, STATUS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude prend le premier point de Next et le réalise selon les règles de ~/Projects/CLAUDE.md : branche, vérifications, PR, STATUS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude mengambil butir pertama Next dan mengerjakannya sesuai aturan ~/Projects/CLAUDE.md: branch, pemeriksaan, PR, STATUS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude prende il primo punto di Next e lo esegue secondo le regole di ~/Projects/CLAUDE.md: branch, controlli, PR, STATUS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude は Next の最初の項目を取り、~/Projects/CLAUDE.md のルールに従って進めます: ブランチ、チェック、PR、STATUS。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 Next의 첫 항목을 가져와 ~/Projects/CLAUDE.md 규칙대로 처리합니다: 브랜치, 검사, PR, STATUS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude bierze pierwszy punkt z Next i wykonuje go według zasad ~/Projects/CLAUDE.md: gałąź, kontrole, PR, STATUS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude pega o primeiro item de Next e o faz segundo as regras de ~/Projects/CLAUDE.md: branch, verificações, PR, STATUS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude бере перший пункт Next і виконує його за правилами ~/Projects/CLAUDE.md: гілка, перевірки, PR, STATUS."
          }
        }
      }
    },
    "Claude выполняет ваш текст по тем же правилам.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينفّذ Claude نصك بالقواعد نفسها."
          }
        },
