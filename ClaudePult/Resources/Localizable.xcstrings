{
  "sourceLanguage": "ru",
  "strings": {
    "": {},
    " (копия)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (copy)"
          }
        }
      }
    },
    " Claude Code подхватывает изменения сам, в том числе в открытых сессиях.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code picks up the change by itself, including open sessions."
          }
        }
      }
    },
    " Нет на этом Маке: %@ — после импорта выберите свои папки.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Not on this Mac: %@ — choose your own folders after the import."
          }
        }
      }
    },
    " млн": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "M"
