    "Пока пусто: скопируйте что-нибудь. Пароли из менеджеров паролей не запоминаются.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فارغ حتى الآن: انسخ شيئًا. لا تُحفظ كلمات المرور من مديرات كلمات المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch leer: kopieren Sie etwas. Passwörter aus Passwortmanagern werden nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty so far: copy something. Passwords from password managers are not recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacío por ahora: copia algo. Las contraseñas de los gestores no se guardan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide pour l’instant : copiez quelque chose. Les mots de passe des gestionnaires ne sont pas retenus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih kosong: salin sesuatu. Kata sandi dari pengelola kata sandi tidak dicatat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora vuoto: copia qualcosa. Le password dei gestori non vengono registrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ空です。何かをコピーしてください。パスワードマネージャのパスワードは記録しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 비어 있습니다. 무언가를 복사하세요. 암호 관리자의 암호는 기록하지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie pusto: skopiuj coś. Hasła z menedżerów haseł nie są zapamiętywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio por enquanto: copie algo. Senhas de gerenciadores não são guardadas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки порожньо: скопіюйте щось. Паролі з менеджерів паролів не запам’ятовуються."
          }
        }
      }
    },
