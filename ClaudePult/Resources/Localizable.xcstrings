    "«%@» запустится в фоне в %@, после сброса лимита.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will start in the background at %@, after the limit resets."
          }
        },
        "es": {
          "stringUnit": {
