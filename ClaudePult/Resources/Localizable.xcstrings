    "Новое окно Терминала: видно, что делает Claude, можно отвечать на вопросы": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نافذة طرفية جديدة: ترى ما يفعله Claude ويمكنك الإجابة عن أسئلته"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Terminal-Fenster: Sie sehen, was Claude tut, und können seine Fragen beantworten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new Terminal window: you see what Claude does and can answer its questions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ventana nueva de Terminal: ves lo que hace Claude y puedes responder a sus preguntas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle fenêtre Terminal : vous voyez ce que fait Claude et pouvez répondre à ses questions"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela Terminal baru: Anda melihat apa yang dilakukan Claude dan bisa menjawab pertanyaannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nuova finestra del Terminale: vedi cosa fa Claude e puoi rispondere alle sue domande"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいターミナルウィンドウ: Claude の作業が見え、質問に答えられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 터미널 창: Claude가 하는 일을 보고 질문에 답할 수 있습니다"
          }
        },
        "pl": {
