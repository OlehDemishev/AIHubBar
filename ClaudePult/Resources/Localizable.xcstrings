            "value": "يأخذ Claude أول بند في Next وينفّذه وفق قواعد ~/Projects/CLAUDE.md: فرع، فحوصات، PR، STATUS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nimmt den ersten Next-Punkt und erledigt ihn nach den Regeln von ~/Projects/CLAUDE.md: Branch, Prüfungen, PR, STATUS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude takes the first Next item and does it by the rules of ~/Projects/CLAUDE.md: branch, checks, PR, STATUS."
