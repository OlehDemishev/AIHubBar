    "Папка пуста — проекты появятся, когда вы их создадите.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجلد فارغ — ستظهر المشاريع عندما تنشئها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner ist leer — Projekte erscheinen, sobald Sie sie anlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder is empty — projects appear once you create them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta está vacía — los proyectos aparecerán cuando los crees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier est vide — les projets apparaîtront quand vous les créerez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder kosong — proyek akan muncul setelah Anda membuatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella è vuota — i progetti compariranno quando li creerai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダーは空です — プロジェクトは作成すると表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더가 비어 있습니다 — 프로젝트는 만들면 나타납니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder jest pusty — projekty pojawią się, gdy je utworzysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta está vazia — os projetos aparecem quando você os criar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка порожня — проєкти з'являться, коли ви їх створите."
          }
        }
      }
    },
