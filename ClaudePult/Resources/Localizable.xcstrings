    "Проекты профиля: git-репозитории или папки, карточки, команды. Настраиваются в профиле.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشاريع ملف التعريف: مستودعات git أو مجلدات، بطاقات، أوامر. تُضبط في ملف التعريف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Projekte des Profils: Git-Repositorys oder Ordner, Karten, Befehle. Eingestellt im Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile's projects: git repositories or folders, cards, commands. Set up in the profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos del perfil: repositorios git o carpetas, fichas, comandos. Se configuran en el perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets du profil : dépôts git ou dossiers, fiches, commandes. Se règlent dans le profil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek profil: repositori git atau folder, kartu, perintah. Diatur di profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progetti del profilo: repository git o cartelle, schede, comandi. Si impostano nel profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルのプロジェクト: git リポジトリまたはフォルダ、カード、コマンド。プロファイルで設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필의 프로젝트: git 저장소 또는 폴더, 카드, 명령. 프로필에서 설정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekty profilu: repozytoria git albo foldery, karty, polecenia. Ustawiane w profilu."
          }
