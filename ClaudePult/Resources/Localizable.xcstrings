    "Такой папки пока нет — она будет создана при «Готово».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المجلد غير موجود بعد — سيُنشأ عند «تم»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Ordner gibt es noch nicht — er wird bei „Fertig“ angelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder does not exist yet — it is created on “Done”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta aún no existe — se creará al pulsar «Listo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier n'existe pas encore — il sera créé en touchant «Terminé»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini belum ada — akan dibuat saat «Selesai»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella non esiste ancora — verrà creata con «Fine»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダーはまだありません — 「完了」で作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 아직 없습니다 — «완료»를 누르면 만들어집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Takiego folderu jeszcze nie ma — zostanie utworzony po „Gotowe”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta ainda não existe — ela será criada ao tocar em «Pronto»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Такої папки поки немає — її буде створено після «Готово»."
          }
        }
      }
    },
