          }
        }
      }
    },
    "Месяц или неделя. Перетащите запись на другой день — дата перепишется в файле. Двойной клик по дню — новая запись.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهر أو أسبوع. اسحب بندًا إلى يوم آخر — يُعاد كتابة التاريخ في ملفه. نقر مزدوج على يوم — بند جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monat oder Woche. Ziehen Sie einen Eintrag auf einen anderen Tag — das Datum wird in seiner Datei umgeschrieben. Doppelklick auf einen Tag — ein neuer Eintrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Month or week. Drag an entry to another day — the date is rewritten in its file. Double-click a day — a new entry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes o semana. Arrastra una entrada a otro día y la fecha se reescribe en su archivo. Doble clic en un día: una entrada nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mois ou semaine. Faites glisser une entrée sur un autre jour : la date est réécrite dans son fichier. Double-clic sur un jour : une nouvelle entrée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan atau minggu. Seret entri ke hari lain — tanggalnya ditulis ulang di berkasnya. Klik dua kali sebuah hari — entri baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mese o settimana. Trascina una voce su un altro giorno: la data viene riscritta nel suo file. Doppio clic su un giorno: una nuova voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月または週。項目を別の日にドラッグすると、日付がそのファイルに書き直されます。日をダブルクリック — 新しい項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 또는 주. 항목을 다른 날로 끌면 날짜가 그 파일에 다시 쓰입니다. 날짜를 더블 클릭 — 새 항목."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesiąc lub tydzień. Przeciągnij wpis na inny dzień — data zostanie zapisana w jego pliku. Dwuklik na dniu — nowy wpis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mês ou semana. Arraste um item para outro dia e a data é reescrita no arquivo. Clique duplo em um dia: um item novo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць або тиждень. Перетягніть запис на інший день — дата перепишеться у файлі. Подвійний клік по дню — новий запис."
          }
        }
      }
    },
    "Минимум": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأدنى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum"
          }
        },
        "en": {
