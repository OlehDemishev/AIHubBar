    "Какие блоки показывать в панели и в каком порядке — у каждого профиля: вкладка «Профили» → «Панель».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي الكتل تظهر في اللوحة وبأي ترتيب يُضبط لكل ملف تعريف: علامة التبويب «ملفات التعريف» ← «اللوحة»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Blöcke das Panel zeigt und in welcher Reihenfolge, legt jedes Profil fest: Tab „Profile“ → „Panel“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which blocks the panel shows and in what order is set per profile: the «Profiles» tab → «Panel»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué bloques muestra el panel y en qué orden se elige en cada perfil: pestaña «Perfiles» → «Panel»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les blocs du panneau et leur ordre se règlent dans chaque profil : onglet «Profils» → «Panneau»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blok yang tampil di panel dan urutannya diatur per profil: tab «Profil» → «Panel»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali blocchi mostra il pannello e in che ordine si sceglie in ogni profilo: scheda «Profili» → «Pannello»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルに表示するブロックと順番はプロファイルごとに設定します: 「プロファイル」 タブ → 「パネル」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널에 보일 블록과 순서는 프로필마다 정합니다: «프로필» 탭 → «패널»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakie bloki pokazuje panel i w jakiej kolejności, ustawia każdy profil: karta «Profile» → «Panel»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quais blocos o painel mostra e em que ordem é definido em cada perfil: aba «Perfis» → «Painel»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Які блоки показувати в панелі й у якому порядку — у кожного профілю: вкладка «Профілі» → «Панель»."
          }
        }
      }
    },
