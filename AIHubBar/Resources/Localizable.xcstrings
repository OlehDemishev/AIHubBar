    "Так выглядит строка, когда есть что показать.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا يبدو العنصر عندما يكون هناك ما يُعرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sieht das Element aus, wenn es etwas zu zeigen gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the item when there is something to show."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así se ve el elemento cuando hay algo que mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici l'élément quand il y a quelque chose à montrer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Begini tampilan item saat ada yang ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così appare l'elemento quando c'è qualcosa da mostrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する内容があるときの見た目です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보여 줄 것이 있을 때의 모습입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak wygląda element, gdy jest co pokazać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim fica o item quando há algo para mostrar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так виглядає рядок, коли є що показати."
          }
        }
