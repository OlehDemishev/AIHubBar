    "Тема, стеклянный фон, размер текста, ширина и плотность — Настройки → «Внешний вид».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السمة، والخلفية الزجاجية، وحجم النص، والعرض، والكثافة — الإعدادات ← «المظهر»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design, Glashintergrund, Textgröße, Breite und Dichte — Einstellungen → „Darstellung“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme, glass background, text size, width and density — Settings → “Appearance”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, fondo de cristal, tamaño del texto, ancho y densidad — Ajustes → «Apariencia»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème, fond en verre, taille du texte, largeur et densité — Réglages → « Apparence »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, latar kaca, ukuran teks, lebar, dan kerapatan — Pengaturan → «Tampilan»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, sfondo in vetro, dimensione del testo, larghezza e densità — Impostazioni → «Aspetto»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、ガラス背景、文字サイズ、幅、密度 — 設定 → 「外観」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 유리 배경, 글자 크기, 너비, 밀도 — 설정 → «모양»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motyw, szklane tło, rozmiar tekstu, szerokość i gęstość — Ustawienia → „Wygląd”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, fundo de vidro, tamanho do texto, largura e densidade — Ajustes → «Aparência»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема, скляний фон, розмір тексту, ширина й щільність — Налаштування → «Вигляд»."
          }
        }
      }
    },
