    "Последние копирования: поиск, закрепление, снова в буфер одним кликом. Пароли из менеджеров паролей не запоминаются.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ الأخيرة: بحث، تثبيت، وإعادة إلى الحافظة بنقرة. لا تُحفظ كلمات المرور من مديرات كلمات المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Kopien: suchen, anheften, mit einem Klick zurück in die Zwischenablage. Passwörter aus Passwortmanagern werden nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent copies: search, pin, back to the clipboard in one click. Passwords from password managers are not recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias recientes: buscar, fijar, de vuelta al portapapeles con un clic. Las contraseñas de los gestores no se guardan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies récentes : recherche, épinglage, retour au presse-papiers en un clic. Les mots de passe des gestionnaires ne sont pas retenus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan terbaru: cari, sematkan, kembali ke papan klip sekali klik. Kata sandi dari pengelola kata sandi tidak dicatat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie recenti: cerca, fissa, di nuovo negli appunti con un clic. Le password dei gestori non vengono registrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のコピー: 検索、ピン留め、ワンクリックでクリップボードへ。パスワードマネージャのパスワードは記録しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 복사: 검색, 고정, 한 번의 클릭으로 다시 클립보드로. 암호 관리자의 암호는 기록하지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie kopie: wyszukiwanie, przypinanie, z powrotem do schowka jednym kliknięciem. Hasła z menedżerów haseł nie są zapamiętywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias recentes: buscar, fixar, de volta à área de transferência num clique. Senhas de gerenciadores não são guardadas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останні копіювання: пошук, закріплення, знову в буфер одним кліком. Паролі з менеджерів паролів не запам’ятовуються."
          }
        }
      }
    },
