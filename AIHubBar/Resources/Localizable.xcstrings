            "value": "Erscheint, wenn ein Profil die _daily-report-Befehle hat – „Profile“ → Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears when a profile has the _daily-report commands — “Profiles” → profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
