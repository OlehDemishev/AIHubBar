          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisogna consentire AI Hub Bar in Impostazioni di Sistema → Generali → Elementi login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → 一般 → ログイン項目で AI Hub Bar を許可する必要があります。"
