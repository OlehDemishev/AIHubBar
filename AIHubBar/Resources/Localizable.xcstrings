    "Календарь включается у профиля с проектами-папками: Настройки → «Профили» → «Календарь».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفعَّل التقويم في ملف تعريف بمشاريع على شكل مجلدات: الإعدادات ← «ملفات التعريف» ← «التقويم»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalender wird bei einem Profil mit Ordner-Projekten eingeschaltet: Einstellungen → „Profile“ → „Kalender“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar is turned on for a profile with folder projects: Settings → “Profiles” → “Calendar”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario se activa en un perfil con proyectos en carpetas: Ajustes → «Perfiles» → «Calendario»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier s'active dans un profil à projets-dossiers : Réglages → «Profils» → «Calendrier»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender dinyalakan di profil dengan proyek-folder: Pengaturan → «Profil» → «Kalender»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calendario si attiva in un profilo con progetti-cartella: Impostazioni → «Profili» → «Calendario»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーはフォルダー型プロジェクトのプロファイルでオンにします: 設定 → 「プロファイル」 → 「カレンダー」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더는 폴더 프로젝트 프로필에서 켭니다: 설정 → «프로필» → «캘린더»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarz włącza się w profilu z projektami-folderami: Ustawienia → „Profile” → „Kalendarz”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário é ativado em um perfil com projetos em pastas: Ajustes → «Perfis» → «Calendário»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Календар вмикається в профілі з проєктами-папками: Налаштування → «Профілі» → «Календар»."
          }
        }
      }
    },
