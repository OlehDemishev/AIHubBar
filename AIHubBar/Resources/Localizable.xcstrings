    "Напишите задачу одним сообщением. /cancel — отмена.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the task in one message. /cancel — cancel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишіть задачу одним повідомленням. /cancel — скасувати."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie die Aufgabe in einer Nachricht. /cancel – abbrechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez la tâche en un message. /cancel — annuler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la tarea en un mensaje. /cancel: cancelar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi l'attività in un messaggio. /cancel — annulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva a tarefa em uma mensagem. /cancel — cancelar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz zadanie w jednej wiadomości. /cancel — anuluj."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを 1 通のメッセージで書いてください。/cancel — キャンセル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 메시지 하나로 쓰세요. /cancel — 취소."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب المهمة في رسالة واحدة. ‎/cancel — إلغاء."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis tugas dalam satu pesan. /cancel — batal."
          }
        }
      }
    },
