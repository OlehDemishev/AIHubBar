    "Свои кнопки: скрипт в фоне или в Терминале, ярлык из «Команд» macOS, ссылка, файл, папка или приложение.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزرارك الخاصة: سكربت في الخلفية أو في الطرفية، اختصار من «الاختصارات» في macOS، رابط أو ملف أو مجلد أو تطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Tasten: ein Skript im Hintergrund oder im Terminal, ein macOS-„Kurzbefehle“-Kurzbefehl, ein Link, eine Datei, ein Ordner oder eine App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own buttons: a script in the background or in Terminal, a macOS «Shortcuts» shortcut, a link, file, folder or app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus botones: un script en segundo plano o en Terminal, un atajo de «Atajos» de macOS, un enlace, archivo, carpeta o app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos boutons : un script en arrière-plan ou dans Terminal, un raccourci « Raccourcis » de macOS, un lien, un fichier, un dossier ou une app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol sendiri: skrip di latar belakang atau Terminal, pintasan «Pintasan» macOS, tautan, file, folder, atau aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsanti tuoi: uno script in background o nel Terminale, un comando di «Comandi rapidi» di macOS, un link, un file, una cartella o un’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のボタン: バックグラウンドまたはターミナルのスクリプト、macOS の「ショートカット」、リンク、ファイル、フォルダ、アプリ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 버튼: 백그라운드 또는 터미널 스크립트, macOS «단축어», 링크, 파일, 폴더, 앱."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własne przyciski: skrypt w tle lub w Terminalu, skrót z «Skróty» macOS, link, plik, folder albo aplikacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus botões: script em segundo plano ou no Terminal, atalho do «Atalhos» do macOS, link, arquivo, pasta ou app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свої кнопки: скрипт у фоні чи в Терміналі, ярлик із «Швидкі команди» macOS, посилання, файл, папка або застосунок."
          }
        }
      }
    },
