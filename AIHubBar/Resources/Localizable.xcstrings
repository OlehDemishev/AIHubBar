    "Сессия и неделя подписки Claude, прогноз, расход по проектам и по API.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة وأسبوع اشتراك Claude، والتوقّع، والاستهلاك حسب المشروع وإنفاق API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung und Woche des Claude-Abos, Prognose, Verbrauch nach Projekt und API-Kosten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude subscription session and week, forecast, usage by project and API spend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión y semana de la suscripción de Claude, previsión, uso por proyecto y gasto de API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session et semaine de l’abonnement Claude, prévision, usage par projet et dépenses d’API."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi dan minggu langganan Claude, prakiraan, pemakaian per proyek dan biaya API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessione e settimana dell’abbonamento Claude, previsione, uso per progetto e spesa API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude サブスクリプションのセッションと週、予測、プロジェクト別の使用量と API の支出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 구독의 세션과 주간, 예측, 프로젝트별 사용량과 API 비용."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja i tydzień subskrypcji Claude, prognoza, zużycie według projektów i wydatki na API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão e semana da assinatura do Claude, previsão, uso por projeto e gasto de API."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесія й тиждень підписки Claude, прогноз, витрата за проєктами й на API."
          }
        }
      }
    },
    "Сессия использована на %@%@. Фоновая задача может упереться в лимит.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استُخدمت الجلسة بنسبة %@%@. قد تصطدم المهمة الخلفية بالحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung ist zu %@ verbraucht%@. Eine Hintergrundaufgabe kann ans Limit stoßen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session is %@ used%@. A background task may hit the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión está usada al %@%@. La tarea en segundo plano puede chocar con el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session est utilisée à %@%@. La tâche en arrière-plan risque d'atteindre la limite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi sudah terpakai %@%@. Tugas latar belakang bisa terbentur batas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è usata al %@%@. Un'attività in background può raggiungere il limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションは %@ 使用済み%@。バックグラウンドタスクが制限に達するおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션을 %@ 썼습니다%@. 백그라운드 작업이 한도에 걸릴 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja jest zużyta w %@%@. Zadanie w tle może dojść do limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão está %@ usada%@. A tarefa em segundo plano pode bater no limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "Сессия использована на %1$@%2$@. Фоновая задача может упереться в лимит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесію використано на %@%@. Фонове завдання може впертися в ліміт."
          }
        }
      }
    },
    "Сессия с обратным отсчётом до сброса и прогнозом по темпу за 30 мин, неделя, недели по моделям, extra usage.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلسة مع عدّ تنازلي لإعادة الضبط وتوقّع بحسب وتيرة آخر 30 د، والأسبوع، والأسابيع حسب النموذج، وextra usage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung mit Countdown bis zur Zurücksetzung und Prognose nach dem Tempo der letzten 30 min, die Woche, Wochen nach Modell, Extra usage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session with a countdown to the reset and a forecast from the last 30 min, the week, weeks per model, extra usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión con cuenta atrás hasta el reinicio y previsión según el ritmo de los últimos 30 min, la semana, semanas por modelo, extra usage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session avec un compte à rebours avant la réinitialisation et une prévision selon le rythme des 30 dernières minutes, la semaine, les semaines par modèle, extra usage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi dengan hitung mundur ke reset dan prakiraan berdasarkan laju 30 mnt terakhir, minggu, minggu per model, extra usage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione con conto alla rovescia fino all'azzeramento e previsione in base al ritmo degli ultimi 30 min, la settimana, le settimane per modello, extra usage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットまでのカウントダウンと直近 30 分のペースによる予測付きのセッション、週、モデル別の週、extra usage。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기화까지 카운트다운과 최근 30분 속도에 따른 예측이 있는 세션, 주간, 모델별 주간, extra usage."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja z odliczaniem do resetu i prognozą według tempa z ostatnich 30 min, tydzień, tygodnie według modeli, extra usage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão com contagem até o reinício e previsão pelo ritmo dos últimos 30 min, a semana, semanas por modelo, extra usage."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесія з відліком до скидання і прогнозом за темпом за 30 хв, тиждень, тижні за моделями, extra usage."
          }
        }
      }
    },
