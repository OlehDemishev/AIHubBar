        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy i publikacje z projekt.md, wiersze plan-tresci.md — w profilach z włączonym kalendarzem (Ustawienia → „Profile”)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prazos e publicações de projeto.md, linhas de plano-de-conteudo.md — nos perfis com o calendário ativado (Ajustes → «Perfis»)."
          }
        },
        "uk": {
          "stringUnit": {
