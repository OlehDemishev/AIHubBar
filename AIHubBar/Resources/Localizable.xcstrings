    "Разрешить или отклонить запрос, который сейчас в острове. Клавишей легко разрешить, не прочитав команду.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالطلب المعروض في الجزيرة أو رفضه. من السهل السماح بمفتاح دون قراءة الأمر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage auf der Insel erlauben oder ablehnen. Mit einer Taste erlaubt man leicht, ohne den Befehl zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow or deny the request now on the island. With a key it’s easy to allow without reading the command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir o rechazar la solicitud que está en la isla. Con una tecla es fácil permitir sin leer el comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser ou refuser la demande affichée sur l’île. Avec une touche, on autorise facilement sans lire la commande."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan atau tolak permintaan yang ada di pulau. Dengan tombol, mudah mengizinkan tanpa membaca perintahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti o rifiuta la richiesta ora sull’isola. Con un tasto è facile consentire senza leggere il comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイランドに表示中のリクエストを許可または拒否します。キーだとコマンドを読まずに許可しやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아일랜드에 있는 요청을 허용하거나 거부합니다. 키로는 명령을 읽지 않고 허용하기 쉽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól lub odrzuć prośbę widoczną na wyspie. Klawiszem łatwo zezwolić, nie czytając polecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir ou recusar a solicitação que está na ilha. Com uma tecla é fácil permitir sem ler o comando."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити або відхилити запит, що зараз на острові. Клавішею легко дозволити, не прочитавши команду."
          }
        }
      }
    },
