    "Выключить модуль: перестанет работать, место в профилях сохранится": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف الوحدة: تتوقف عن العمل ويُحفظ مكانها في ملفات التعريف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul ausschalten: Es arbeitet nicht mehr, sein Platz in den Profilen bleibt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the module: it stops working, its place in the profiles is kept"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar el módulo: deja de funcionar y conserva su lugar en los perfiles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le module : il s’arrête, sa place dans les profils est conservée"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan modul: berhenti bekerja, tempatnya di profil tetap disimpan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva il modulo: smette di funzionare, il suo posto nei profili resta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モジュールをオフにする: 動作を停止し、プロファイル内の位置は保持されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모듈 끄기: 작동을 멈추고 프로필 안의 위치는 유지됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz moduł: przestanie działać, jego miejsce w profilach zostanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar o módulo: ele para de funcionar, o lugar nos perfis é mantido"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути модуль: перестане працювати, місце в профілях збережеться"
          }
        }
      }
    },
