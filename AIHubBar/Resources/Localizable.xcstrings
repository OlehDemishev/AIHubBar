            "state": "translated",
            "value": "Manter a tela ligada também"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не гасити й екран"
          }
        }
      }
    },
    "Не давать Mac засыпать, пока не выключите": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء الـMac مستيقظًا حتى تُطفئ ذلك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Mac wach halten, bis Sie ausschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the Mac awake until you switch this off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el Mac despierto hasta que lo apagues"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le Mac éveillé jusqu’à désactivation"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga Mac tetap terjaga sampai dimatikan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni sveglio il Mac finché non lo spegni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするまで Mac をスリープさせない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌 때까지 Mac을 깨어 있게 유지"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie usypiaj Maca, dopóki nie wyłączysz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter o Mac acordado até você desligar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давати Mac засинати, доки не вимкнете"
          }
        }
      }
    },
