            "state": "translated",
            "value": "Klick zum Öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic para abrir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic pour ouvrir"
          }
        },
        "id": {
          "stringUnit": {
