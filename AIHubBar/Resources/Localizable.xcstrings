    "Дедлайны и публикации из карточек проектов и контент-плана — на неделю вперёд и в окне «Календарь».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواعيد النهائية والنشر من بطاقات المشاريع وخطة المحتوى — للأسبوع القادم وفي نافذة «التقويم»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines und Veröffentlichungen aus Projektkarten und dem Content-Plan — eine Woche im Voraus und im Fenster „Kalender“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines and publications from project cards and the content plan — a week ahead, and in the “Calendar” window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechas límite y publicaciones de las fichas de proyecto y del plan de contenido — para la próxima semana y en la ventana «Calendario»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échéances et publications des fiches de projet et du plan de contenu — sur la semaine à venir et dans la fenêtre « Calendrier »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenggat dan publikasi dari kartu proyek dan rencana konten — untuk seminggu ke depan dan di jendela «Kalender»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scadenze e pubblicazioni dalle schede dei progetti e dal piano editoriale — per la settimana successiva e nella finestra «Calendario»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトカードとコンテンツプランの締め切りと公開予定 — 1 週間先まで、「カレンダー」ウィンドウでも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 카드와 콘텐츠 계획의 마감일과 게시 일정 — 일주일 앞까지, «캘린더» 창에서도."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy i publikacje z kart projektów i planu treści — na tydzień naprzód i w oknie „Kalendarz”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prazos e publicações dos cartões de projeto e do plano de conteúdo — para a semana seguinte e na janela «Calendário»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дедлайни й публікації з карток проєктів і контент-плану — на тиждень уперед і у вікні «Календар»."
          }
        }
      }
    },
