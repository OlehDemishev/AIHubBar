    "Папки worktree нет — выполните `git worktree prune` в проекте.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلد worktree غير موجود — نفّذ `git worktree prune` في المشروع."
          }
        },
        "de": {
          "stringUnit": {
