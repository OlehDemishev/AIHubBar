          "stringUnit": {
            "state": "translated",
            "value": "Auf Bildschirmen ohne Notch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On screens without a notch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pantallas sin muesca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les écrans sans encoche"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di layar tanpa notch"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugli schermi senza notch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチのない画面では"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치 없는 화면에서"
          }
        },
        "pl": {
          "stringUnit": {
