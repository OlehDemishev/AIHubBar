    "Включено «Уменьшить прозрачность» — панель остаётся с обычным фоном.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيار «تقليل الشفافية» مفعّل، لذا تبقى اللوحة بالخلفية العادية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Transparenz reduzieren“ ist aktiv, das Panel behält den normalen Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Reduce transparency” is on, so the panel keeps the standard background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reducir transparencia» está activado: el panel mantiene el fondo normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réduire la transparence » est activé : le panneau garde le fond normal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kurangi transparansi” aktif, jadi panel tetap memakai latar biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Riduci trasparenza» è attivo: il pannello mantiene lo sfondo normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「透明度を下げる」がオンのため、パネルは通常の背景のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘투명도 줄이기’가 켜져 있어 패널은 기본 배경을 유지합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączono „Zmniejsz przezroczystość”, więc panel ma zwykłe tło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Reduzir transparência” está ativado, então o painel mantém o fundo normal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено «Зменшити прозорість» — панель лишається зі звичайним тлом."
          }
        }
      }
    },
