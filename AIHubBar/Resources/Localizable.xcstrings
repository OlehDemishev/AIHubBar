          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідає один Мак цього чату; перемкнути можна й командою /macs у боті"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
