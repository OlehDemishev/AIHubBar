    "Сообщений боту не нашлось: напишите ему что-нибудь и попробуйте снова.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد رسائل إلى البوت: اكتب له شيئًا وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nachrichten an den Bot: Schreiben Sie ihm etwas und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No messages to the bot yet: write it something and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot no tiene mensajes: escríbele algo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun message au bot : écrivez-lui quelque chose et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pesan ke bot: kirim sesuatu lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun messaggio al bot: scrivigli qualcosa e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットへのメッセージがありません。何か送ってからもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "봇에 보낸 메시지가 없습니다. 뭔가 보낸 뒤 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wiadomości do bota: napisz coś i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot ainda não tem mensagens: escreva algo e tente de novo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлень боту не знайшлося: напишіть йому щось і спробуйте знову."
          }
        }
      }
    },
    "Сообщить на GitHub…": {
