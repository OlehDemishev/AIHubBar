          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparirà quando un profilo ha i comandi _daily-report — «Profili» → profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルに _daily-report のコマンドがあるときに表示されます —「プロファイル」→ プロファイル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필에 _daily-report 명령이 있으면 나타납니다 — «프로필» → 프로필."
          }
        },
        "pl": {
