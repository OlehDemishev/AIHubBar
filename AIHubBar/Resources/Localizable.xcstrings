    },
    "Mac не засыпает по правилам": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى Mac مستيقظًا وفق قواعد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac bleibt nach Regeln wach"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the Mac awake based on rules"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac no se duerme según reglas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac reste éveillé selon des règles"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tetap terjaga sesuai aturan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac resta sveglio secondo regole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールに従ってMacをスリープさせない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙에 따라 Mac이 잠들지 않음"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nie zasypia według reguł"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac não dorme conforme regras"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не засинає за правилами"
          }
        }
      }
    },
    "Mac не засыпает, пока работает Claude, на время, при подключённом питании или мониторе, пока открыты выбранные приложения.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى الـMac مستيقظًا أثناء عمل Claude، أو لمدة محددة، أو عند توصيل الطاقة أو شاشة، أو أثناء فتح تطبيقات مختارة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac bleibt wach, solange Claude arbeitet, für eine Zeit, am Netz oder mit Monitor, oder solange gewählte Apps offen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac stays awake while Claude works, for a while, on power or with a display connected, or while chosen apps are open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac no duerme mientras Claude trabaja, durante un tiempo, conectado a la corriente o a un monitor, o con ciertas apps abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac reste éveillé pendant que Claude travaille, un certain temps, sur secteur ou avec un écran, ou tant que des apps choisies sont ouvertes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tetap terjaga selama Claude bekerja, selama waktu tertentu, saat tersambung daya atau monitor, atau saat aplikasi pilihan terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac resta sveglio mentre Claude lavora, per un certo tempo, con alimentazione o monitor collegati, o con app scelte aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude の作業中、一定時間、電源や外部ディスプレイの接続中、選んだアプリが開いている間、Mac をスリープさせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 작업하는 동안, 일정 시간, 전원이나 모니터 연결 중, 선택한 앱이 열려 있는 동안 Mac이 잠들지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nie usypia, gdy Claude pracuje, przez wybrany czas, przy zasilaniu lub monitorze albo gdy otwarte są wybrane aplikacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac não dorme enquanto o Claude trabalha, por um tempo, na tomada ou com monitor, ou com apps escolhidos abertos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не засинає, поки працює Claude, на певний час, при підключеному живленні чи моніторі, поки відкриті вибрані застосунки."
          }
        }
      }
    },
