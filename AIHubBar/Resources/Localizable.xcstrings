            "state": "translated",
            "value": "Cincin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierścień"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anel"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце"
          }
        }
      }
    },
    "Кольцо и «3/7» по списку задач Claude, шаги в карточке, итог в «Готово». Без списка — минуты с начала ответа.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلقة و«3/7» من قائمة مهام Claude، والخطوات في البطاقة، والملخص في «تم». دون قائمة: الدقائق منذ بدء الرد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ring und „3/7“ aus Claudes Aufgabenliste, Schritte in der Karte, Ergebnis in „Fertig“. Ohne Liste: Minuten seit Beginn der Antwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ring and “3/7” from Claude’s task list, the steps in the card, the result in “Done”. Without a list: minutes since the answer began."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo y «3/7» según la lista de tareas de Claude, los pasos en la tarjeta, el resultado en «Listo». Sin lista: minutos desde el inicio de la respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anneau et « 3/7 » d’après la liste de tâches de Claude, les étapes dans la carte, le bilan dans « Terminé ». Sans liste : minutes depuis le début de la réponse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cincin dan “3/7” dari daftar tugas Claude, langkah-langkah di kartu, hasil di “Selesai”. Tanpa daftar: menit sejak jawaban dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anello e «3/7» dall’elenco attività di Claude, i passi nella scheda, il risultato in «Fatto». Senza elenco: minuti dall’inizio della risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude のタスクリストからリングと「3/7」、カードに手順、「完了」に結果。リストがなければ回答開始からの分数。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 작업 목록의 링과 “3/7”, 카드의 단계, “완료”의 결과. 목록이 없으면 답변 시작 후 경과한 분."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierścień i „3/7” z listy zadań Claude, kroki na karcie, wynik w „Gotowe”. Bez listy: minuty od początku odpowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel e “3/7” pela lista de tarefas do Claude, os passos no cartão, o resultado em “Pronto”. Sem lista: minutos desde o início da resposta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце й «3/7» за списком завдань Claude, кроки в картці, підсумок у «Готово». Без списку — хвилини від початку відповіді."
          }
        }
      }
    },
    "Команд нет — добавьте в Настройках → «Модули».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أوامر — أضفها من الإعدادات ← «الوحدات»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Befehle — unter Einstellungen → „Module“ hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No commands — add some in Settings → «Modules»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay comandos: añádelos en Ajustes → «Módulos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune commande — ajoutez-en dans Réglages → « Modules »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perintah — tambahkan di Pengaturan → «Modul»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun comando — aggiungili in Impostazioni → «Moduli»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドがありません — 設定 →「モジュール」で追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령이 없습니다 — 설정 → «모듈»에서 추가하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak poleceń — dodaj je w Ustawieniach → «Moduły»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem comandos — adicione em Ajustes → «Módulos»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команд немає — додайте в Налаштуваннях → «Модулі»."
          }
        }
      }
    },
