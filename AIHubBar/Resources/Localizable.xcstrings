          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot abre no Telegram — toque em “Start” e ele responderá deste Mac"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot otworzy się w Telegramie — naciśnij „Start”, a będzie odpowiadał z tego Maca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram でボットが開きます。「Start」を押すと、この Mac から応答します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram에서 봇이 열립니다. 'Start'를 누르면 이 Mac에서 응답합니다"
