    "Сочетание только с ⌘ заменит его во всех приложениях.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاختصار مع ⌘ فقط يحل محله في كل التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kurzbefehl nur mit ⌘ ersetzt ihn in allen Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shortcut with only ⌘ replaces it in every app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo solo con ⌘ lo sustituye en todas las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raccourci avec seulement ⌘ le remplace dans toutes les apps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan hanya dengan ⌘ menggantikannya di semua aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scorciatoia con solo ⌘ la sostituisce in tutte le app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ だけのショートカットは、すべてのアプリのそのショートカットを置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘만 쓰는 단축키는 모든 앱에서 그 단축키를 대체합니다."
          }
        },
        "pl": {
