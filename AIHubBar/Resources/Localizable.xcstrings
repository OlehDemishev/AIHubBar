            "state": "translated",
            "value": "Telegram غير مُعدّ (الإعدادات ← عامة ← Telegram): سيصل إشعار macOS فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram ist nicht eingerichtet (Einstellungen → Allgemein → Telegram): nur eine macOS-Mitteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram isn't set up (Settings → General → Telegram): only a macOS notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram no está configurado (Ajustes → Generales → Telegram): solo habrá notificación de macOS."
