        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → «프로필» → «+»: «개발자 (GitHub)», «동영상», «글쓰기», «리서치», «소셜 미디어», «사용자 지정». 폴더를 고르면 프로필이 완성되고, 나머지는 그 설정에서 바꿉니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia → „Profile” → „+”: „Programista (GitHub)”, „Wideo”, „Teksty”, „Research”, „Media społecznościowe”, „Własny”. Wybierz folder — profil jest gotowy; resztę zmienisz w jego ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes → «Perfis» → «+»: «Desenvolvedor (GitHub)», «Vídeo», «Textos», «Pesquisa», «Redes sociais», «Personalizado». Escolha uma pasta e o perfil fica pronto; o resto se ajusta nas configurações dele."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування → «Профілі» → «+»: «Розробник (GitHub)», «Відео», «Тексти», «Ресерч», «Соцмережі», «Свій». Виберіть папку — профіль готовий, далі все правиться в його налаштуваннях."
