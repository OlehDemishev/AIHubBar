          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu są tylko włączone moduły. Pozostałe: strona „Moduły”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
