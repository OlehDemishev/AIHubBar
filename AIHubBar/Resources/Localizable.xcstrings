    "Уведомления AI Hub Bar выключены в macOS — «ждёт ответа», итоги задач и лимиты не приходят.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات AI Hub Bar متوقفة في macOS — لا تصل «بانتظار رد» ولا نتائج المهام ولا الحدود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Hub Bar-Mitteilungen sind in macOS aus — „wartet“, Aufgabenergebnisse und Limits kommen nicht an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Hub Bar notifications are off in macOS — “waiting”, task results and limits do not arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de AI Hub Bar están desactivadas en macOS — «espera respuesta», los resultados de tareas y los límites no llegan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de AI Hub Bar sont désactivées dans macOS — «attend une réponse», les résultats des tâches et les limites n'arrivent pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan AI Hub Bar dimatikan di macOS — «menunggu», hasil tugas, dan batas tidak sampai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di AI Hub Bar sono disattivate in macOS — «in attesa», i risultati delle attività e i limiti non arrivano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Hub Bar の通知が macOS でオフです — 「応答待ち」、タスクの結果、制限が届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 AI Hub Bar 알림이 꺼져 있습니다 — «응답 대기», 작업 결과, 한도가 오지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia AI Hub Bar są wyłączone w macOS — „czeka na odpowiedź”, wyniki zadań i limity nie dochodzą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações do AI Hub Bar estão desativadas no macOS — «aguardando resposta», os resultados das tarefas e os limites não chegam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення AI Hub Bar вимкнено в macOS — «чекає на відповідь», підсумки завдань і ліміти не приходять."
          }
        }
      }
    },
    "Уведомления macOS от модуля; как часто — «Основные»": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات macOS من الوحدة؛ وتكرارها في «عام»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-Mitteilungen des Moduls; wie oft – „Allgemein“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS notifications from the module; how often is in “General”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaciones de macOS del módulo; la frecuencia, en «General»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications macOS du module ; la fréquence se règle dans « Général »"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi macOS dari modul; seberapa sering ada di «Umum»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifiche macOS del modulo; la frequenza è in «Generali»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モジュールからのmacOS通知。頻度は「一般」で設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모듈의 macOS 알림. 빈도는 «일반»에서"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia macOS z modułu; jak często — „Ogólne”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificações do macOS do módulo; a frequência fica em «Geral»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення macOS від модуля; як часто — «Загальні»"
          }
        }
      }
    },
    "Уведомления macOS от модуля; как часто — ниже, в «Как часто уведомлять»": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات macOS من الوحدة؛ وتكرارها في الأسفل، «عدد مرات الإشعار»"
