    "Клавишей легко разрешить, не прочитав команду.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من السهل السماح بمفتاح دون قراءة الأمر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer Taste erlaubt man leicht, ohne den Befehl zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a key it’s easy to allow without reading the command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una tecla es fácil permitir sin leer el comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une touche, on autorise facilement sans lire la commande."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan tombol, mudah mengizinkan tanpa membaca perintahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un tasto è facile consentire senza leggere il comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーだとコマンドを読まずに許可しやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
