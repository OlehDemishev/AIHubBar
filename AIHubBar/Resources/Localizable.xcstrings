    "Настройки профиля пропадут. Папки проектов останутся на месте.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُفقد إعدادات ملف التعريف. تبقى مجلدات المشاريع في مكانها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen des Profils gehen verloren. Projektordner bleiben, wo sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile's settings will be lost. Project folders stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán los ajustes del perfil. Las carpetas de proyectos se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages du profil seront perdus. Les dossiers de projets restent en place."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan profil akan hilang. Folder proyek tetap di tempatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni del profilo andranno perse. Le cartelle dei progetti restano al loro posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルの設定は失われます。プロジェクトのフォルダはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 설정이 사라집니다. 프로젝트 폴더는 그대로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia profilu zostaną utracone. Foldery projektów pozostaną na miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes do perfil serão perdidos. As pastas de projetos continuam onde estão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування профілю зникнуть. Папки проєктів залишаться на місці."
          }
        }
      }
    },
