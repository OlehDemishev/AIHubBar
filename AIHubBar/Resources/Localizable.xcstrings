          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Keyboard Layout” on the “Modules” page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Distribución del teclado» en la página «Módulos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Disposition du clavier » sur la page « Modules »."
          }
        },
        "id": {
