    "Что изменила сессия с начала (git): файлы и строки, включая закоммиченное. Клик — список": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما غيّرته الجلسة منذ بدايتها (git): الملفات والأسطر، بما فيها المُثبتة. انقر للقائمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Sitzung seit Beginn geändert hat (git): Dateien und Zeilen, Commits eingeschlossen. Klick für die Liste"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the session changed since it started (git): files and lines, committed work included. Click for the list"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cambió la sesión desde el inicio (git): archivos y líneas, incluido lo confirmado. Clic: la lista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que la session a modifié depuis le début (git) : fichiers et lignes, commits compris. Cliquez pour la liste"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang diubah sesi sejak mulai (git): file dan baris, termasuk yang sudah di-commit. Klik untuk daftar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ha cambiato la sessione dall'inizio (git): file e righe, commit inclusi. Clic per l'elenco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション開始以降の変更（git）: ファイルと行数、コミット済みも含む。クリックで一覧"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 시작 이후 변경(git): 파일과 줄, 커밋한 것 포함. 클릭하면 목록"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co sesja zmieniła od początku (git): pliki i wiersze, także zatwierdzone. Kliknij, by zobaczyć listę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que a sessão mudou desde o início (git): arquivos e linhas, incluindo o que já foi commitado. Clique para a lista"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що змінила сесія від початку (git): файли й рядки, включно із закоміченим. Клік — список"
          }
        }
      }
    },
