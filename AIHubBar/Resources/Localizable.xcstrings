        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de sesiones y «Claude espera respuesta» funcionan con un pequeño script: AI Hub Bar lo añade a ~/.claude/settings.json y guarda una copia de seguridad."
          }
