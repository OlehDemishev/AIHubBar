    "Claude Code найден, но вход не выполнен: без него нет лимитов подписки.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على Claude Code لكن لم يتم تسجيل الدخول: لا تظهر حدود الاشتراك من دونه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist installiert, aber nicht angemeldet: Ohne Anmeldung gibt es keine Abo-Limits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code is installed but not signed in: subscription limits need the sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code está instalado, pero sin iniciar sesión: sin ella no hay límites de suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code est installé mais non connecté : sans connexion, pas de limites d’abonnement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code terpasang tetapi belum masuk: batas langganan memerlukan proses masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code è installato ma senza accesso: senza accesso non ci sono i limiti dell’abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code はインストール済みですが、サインインしていません。サブスクリプションの制限の表示にはサインインが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code가 설치되어 있지만 로그인하지 않았습니다. 구독 한도를 보려면 로그인이 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code jest zainstalowany, ale bez logowania: bez niego nie ma limitów subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude Code está instalado, mas sem login: sem ele não há limites da assinatura."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code знайдено, але вхід не виконано: без нього немає лімітів підписки."
          }
        }
      }
    },
