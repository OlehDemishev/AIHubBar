    "Сервер не отвечает — запущен ли он?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخادم لا يستجيب — هل هو قيد التشغيل؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortet nicht — läuft er?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server does not answer — is it running?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no responde — ¿está en marcha?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne répond pas — est-il lancé ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak menjawab — apakah sedang berjalan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non risponde — è avviato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが応答しません — 起動していますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답하지 않습니다 — 실행 중인가요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie odpowiada — czy jest uruchomiony?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não responde — ele está rodando?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не відповідає — чи запущений він?"
          }
        }
      }
    },
