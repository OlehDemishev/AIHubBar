    "Отвечайте на запросы разрешений прямо из уведомления или строки сессии.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجب عن طلبات الأذونات مباشرة من الإشعار أو من صف الجلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworten Sie Berechtigungsanfragen direkt in der Mitteilung oder in der Sitzungszeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer permission requests right from the notification or the session row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a las solicitudes de permiso directamente desde la notificación o la fila de la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez aux demandes d’autorisation directement depuis la notification ou la ligne de la session."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab permintaan izin langsung dari pemberitahuan atau baris sesi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi alle richieste di permesso direttamente dalla notifica o dalla riga della sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可のリクエストには、通知やセッションの行から直接応答できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 요청에는 알림이나 세션 행에서 바로 응답하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj na prośby o zgodę prosto z powiadomienia lub wiersza sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda às solicitações de permissão direto da notificação ou da linha da sessão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідайте на запити дозволів просто зі сповіщення або рядка сесії."
          }
        }
      }
    },
    "Отвечать на запросы разрешений из уведомлений и панели": {
      "localizations": {
        "ar": {
