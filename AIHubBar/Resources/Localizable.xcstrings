    "Перетащите блок на другой или нажмите ⌃ / ⌄.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب كتلة إلى أخرى أو انقر ⌃ / ⌄."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Block auf einen anderen oder klicken Sie auf ⌃ / ⌄."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a block onto another or click ⌃ / ⌄."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un bloque sobre otro o pulsa ⌃ / ⌄."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un bloc sur un autre ou cliquez sur ⌃ / ⌄."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret blok ke blok lain atau klik ⌃ / ⌄."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un blocco su un altro o premi ⌃ / ⌄."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックを別のブロックの上にドラッグするか、⌃ / ⌄ をクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블록을 다른 블록 위로 끌어 놓거나 ⌃ / ⌄를 누르세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij blok na inny albo kliknij ⌃ / ⌄."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um bloco sobre outro ou clique em ⌃ / ⌄."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть блок на інший або натисніть ⌃ / ⌄."
          }
        }
      }
    },
    "Перетащите блок на другой, чтобы поменять порядок, или нажмите ⌃ / ⌄": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب كتلة إلى أخرى لتغيير الترتيب، أو استخدم ⌃ / ⌄"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Block auf einen anderen, um die Reihenfolge zu ändern, oder nutzen Sie ⌃ / ⌄"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a block onto another to change the order, or use ⌃ / ⌄"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un bloque sobre otro para cambiar el orden o usa ⌃ / ⌄"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez un bloc sur un autre pour changer l’ordre, ou utilisez ⌃ / ⌄"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret blok ke blok lain untuk mengubah urutan, atau gunakan ⌃ / ⌄"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un blocco su un altro per cambiare l’ordine, oppure usa ⌃ / ⌄"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックを別のブロックにドラッグするか ⌃ / ⌄ で順序を変更"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블록을 다른 블록 위로 끌거나 ⌃ / ⌄를 눌러 순서를 바꾸세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij blok na inny, aby zmienić kolejność, albo użyj ⌃ / ⌄"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um bloco sobre outro para mudar a ordem ou use ⌃ / ⌄"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть блок на інший, щоб змінити порядок, або натисніть ⌃ / ⌄"
          }
        }
      }
    },
    "Перетащите на элемент в порядке — встанет после него; клик — в конец": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحبه إلى عنصر في الترتيب ليأتي بعده؛ وانقر لإضافته في النهاية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ein Element in der Reihenfolge ziehen – landet dahinter; Klick – ans Ende"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag onto an element in the order to put it after that element; click to add it at the end"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrástralo sobre un elemento del orden para ponerlo detrás; clic para añadirlo al final"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez sur un élément de l’ordre pour le placer après ; clic pour l’ajouter à la fin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret ke elemen dalam urutan agar ditempatkan setelahnya; klik untuk menambah di akhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina su un elemento dell’ordine per metterlo dopo; clic per aggiungerlo in fondo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並びの要素へドラッグするとその後ろに入ります。クリックで末尾に追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순서의 요소 위로 끌면 그 뒤에 들어갑니다. 클릭하면 끝에 추가"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij na element w kolejności — stanie za nim; kliknięcie — na koniec"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste sobre um elemento da ordem para colocá-lo depois dele; clique para pôr no fim"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть на елемент у порядку — стане після нього; клік — у кінець"
          }
        }
      }
    },
    "Перетащите разделитель на элемент — он встанет сразу после него. Без мыши — «Левее» и «Правее».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الفاصل إلى عنصر ليستقر بعده مباشرة. ومن دون فأرة — «إلى اليسار» و«إلى اليمين»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Trenner auf ein Element — er landet direkt dahinter. Ohne Maus — „Weiter links“ und „Weiter rechts“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a separator onto an item and it lands right after it. Without a mouse — “Further left” and “Further right”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un separador sobre un elemento y quedará justo después. Sin ratón — «Más a la izquierda» y «Más a la derecha»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un séparateur sur un élément : il se place juste après. Sans souris — « Plus à gauche » et « Plus à droite »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pemisah ke elemen — pemisah akan berada tepat setelahnya. Tanpa mouse — «Lebih ke kiri» dan «Lebih ke kanan»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un separatore su un elemento: si posiziona subito dopo. Senza mouse — «Più a sinistra» e «Più a destra»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切りを項目の上にドラッグすると、そのすぐ後ろに入ります。マウスなしなら「左へ」と「右へ」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구분자를 항목 위로 끌어 놓으면 바로 뒤에 들어갑니다. 마우스 없이 — «왼쪽으로»와 «오른쪽으로»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij separator na element — stanie zaraz za nim. Bez myszy — „Bardziej w lewo” i „Bardziej w prawo”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um separador sobre um item e ele fica logo depois. Sem mouse — «Mais à esquerda» e «Mais à direita»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть розділювач на елемент — він стане одразу після нього. Без миші — «Лівіше» і «Правіше»."
          }
        }
      }
    },
    "Перетащите файл или папку на чёлку: команды профиля и «Своя задача» для него, результат — новым файлом рядом.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب ملفًا أو مجلدًا إلى النتوء: أوامر الملف الشخصي و«مهمة خاصة» له، والنتيجة ملف جديد بجانبه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie eine Datei oder einen Ordner auf die Notch: die Befehle des Profils und „Eigene Aufgabe“ dafür, das Ergebnis als neue Datei daneben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a file or folder onto the notch: the profile’s commands and “Custom task” for it, the result as a new file next to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un archivo o carpeta al notch: los comandos del perfil y «Tarea propia» para él; el resultado, un archivo nuevo al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un fichier ou un dossier sur l’encoche : les commandes du profil et « Tâche libre » pour lui, le résultat en nouveau fichier à côté."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret berkas atau folder ke notch: perintah profil dan “Tugas sendiri” untuknya, hasilnya berkas baru di sebelahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un file o una cartella sul notch: i comandi del profilo e «Attività personale» per esso, il risultato come nuovo file accanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルやフォルダをノッチにドラッグ：プロファイルのコマンドと「自分のタスク」、結果は隣に新しいファイルとして。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이나 폴더를 노치로 끌어 놓으면 프로필 명령과 “내 작업”을 쓸 수 있고, 결과는 옆에 새 파일로 저장됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij plik lub folder na notch: polecenia profilu i „Własne zadanie” dla niego, wynik jako nowy plik obok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um arquivo ou pasta para o notch: os comandos do perfil e “Tarefa própria” para ele, o resultado como arquivo novo ao lado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть файл або теку на виїмку: команди профілю й «Своє завдання» для нього, результат — новим файлом поруч."
          }
        }
      }
    },
    "Перетащите файл на остров — откроются AI-команды профиля для него.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب ملفًا إلى الجزيرة لتُفتح له أوامر الذكاء الاصطناعي الخاصة بملف التعريف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie eine Datei auf die Insel — die KI-Befehle des Profils dafür öffnen sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a file on the island to open the profile’s AI commands for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un archivo a la isla y se abrirán los comandos de IA del perfil para él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un fichier sur l’île : les commandes d’IA du profil s’ouvrent pour ce fichier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret file ke pulau — perintah AI profil untuk file itu akan terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un file sull’isola: si aprono i comandi IA del profilo per quel file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをアイランドにドラッグすると、そのファイル用にプロファイルの AI コマンドが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 아일랜드로 끌어 놓으면 그 파일에 쓸 프로필의 AI 명령이 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij plik na wyspę — otworzą się dla niego polecenia AI profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um arquivo para a ilha para abrir os comandos de IA do perfil para ele."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть файл на острів — відкриються AI-команди профілю для нього."
          }
        }
      }
    },
    "Перетащите элемент на другой — встанет на его место. Разделитель, брошенный на элемент, встаёт сразу после него. Клик — настройки элемента.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب عنصرًا إلى آخر ليأخذ مكانه. الفاصل الذي يُفلت على عنصر يوضع بعده مباشرة. انقر لإعدادات العنصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie ein Element auf ein anderes, um seinen Platz einzunehmen. Ein Trenner, der auf einem Element abgelegt wird, landet direkt dahinter. Klick – Einstellungen des Elements."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag an element onto another to take its place. A divider dropped on an element goes right after it. Click an element for its settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un elemento sobre otro para ocupar su lugar. Un separador soltado sobre un elemento queda justo después. Clic: ajustes del elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez un élément sur un autre pour prendre sa place. Un séparateur déposé sur un élément se place juste après. Clic : réglages de l’élément."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret elemen ke elemen lain untuk mengambil tempatnya. Pemisah yang dijatuhkan pada elemen ditempatkan tepat setelahnya. Klik untuk pengaturan elemen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un elemento su un altro per prenderne il posto. Un separatore rilasciato su un elemento va subito dopo. Clic: impostazioni dell’elemento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要素を別の要素にドラッグするとその位置に入ります。要素にドロップした区切りはその直後に入ります。クリックで要素の設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요소를 다른 요소 위로 끌면 그 자리에 들어갑니다. 요소 위에 놓은 구분자는 바로 뒤에 들어갑니다. 클릭하면 요소 설정."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij element na inny — zajmie jego miejsce. Separator upuszczony na element stanie tuż za nim. Kliknięcie — ustawienia elementu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um elemento sobre outro para ocupar o lugar dele. Um separador solto sobre um elemento fica logo depois dele. Clique: configurações do elemento."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть елемент на інший — стане на його місце. Розділювач, кинутий на елемент, стає одразу після нього. Клік — налаштування елемента."
          }
        }
      }
    },
    "Перетащите элемент на другой, чтобы поменять порядок; включить и выключить — в списке ниже.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب عنصرًا فوق آخر لتغيير الترتيب؛ ويُفعَّل ويُعطَّل من القائمة أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie ein Element auf ein anderes, um die Reihenfolge zu ändern; ein- und ausschalten in der Liste unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag an element onto another to change the order; switch them on and off in the list below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un elemento sobre otro para cambiar el orden; actívalos y desactívalos en la lista de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un élément sur un autre pour changer l’ordre ; activez-les ou désactivez-les dans la liste ci-dessous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret elemen ke elemen lain untuk mengubah urutan; nyalakan dan matikan di daftar di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un elemento su un altro per cambiare l’ordine; attivali e disattivali nell’elenco qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要素を別の要素にドラッグすると順序が変わります。オン／オフは下のリストで切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요소를 다른 요소 위로 끌어 순서를 바꿉니다. 켜기와 끄기는 아래 목록에서 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij element na inny, aby zmienić kolejność; włączaj i wyłączaj na liście poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um elemento sobre outro para mudar a ordem; ative e desative na lista abaixo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть елемент на інший, щоб змінити порядок; вмикати й вимикати — у списку нижче."
          }
        }
      }
    },
