          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 이 Mac에 없음: %@ — 가져온 뒤 자신의 폴더를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
