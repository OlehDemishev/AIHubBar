        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” uruchomiono w nowym oknie Terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» iniciado em uma nova janela do Terminal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» запущено в новому вікні Термінала."
          }
        }
      }
    },
    "«%@» запущен в фоне (лимит %lld мин). Итог придёт уведомлением.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ «%@» في الخلفية (الحد %lld د). ستصل النتيجة بإشعار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ im Hintergrund gestartet (Limit %lld min). Das Ergebnis kommt als Mitteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” started in the background (limit %lld min). The result comes as a notification."
          }
        },
        "es": {
