    "Здесь только включённые модули. Остальные — на странице «Модули».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا الوحدات المفعّلة فقط. البقية في صفحة «الوحدات»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier stehen nur aktive Module. Die übrigen: Seite „Module“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only modules that are on are here. The rest are on the “Modules” page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo aparecen los módulos activos. El resto: página «Módulos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les modules actifs sont ici. Les autres : page « Modules »."
          }
        },
        "id": {
