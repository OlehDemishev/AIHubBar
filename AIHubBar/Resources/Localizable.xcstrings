    "Напишите боту любое сообщение, затем нажмите — ID чата подставится сам": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل أي رسالة إلى البوت ثم اضغط: سيُملأ معرّف الدردشة تلقائيًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie dem Bot eine Nachricht und klicken Sie: Die Chat-ID wird eingetragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the bot any message, then press: the chat ID fills in by itself"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía cualquier mensaje al bot y pulsa: el ID del chat se rellena solo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un message au bot puis cliquez : l'ID du chat se remplit seul"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim pesan apa saja ke bot, lalu tekan: ID obrolan terisi sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un messaggio qualsiasi al bot, poi premi: l'ID della chat si compila da solo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットに何かメッセージを送ってから押すと、チャット ID が自動で入ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "봇에 아무 메시지나 보낸 뒤 누르면 채팅 ID가 자동으로 채워집니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz do bota dowolną wiadomość i kliknij — ID czatu wstawi się samo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie qualquer mensagem ao bot e clique: o ID do chat é preenchido sozinho"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишіть боту будь-яке повідомлення, потім натисніть — ID чату підставиться сам"
          }
        }
      }
    },
    "Напишите задачу своими словами — AI выполнит её над файлом": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the task in your own words — AI does it on the file"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишіть завдання своїми словами — AI виконає його над файлом"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie die Aufgabe in eigenen Worten – die KI erledigt sie an der Datei"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez la tâche avec vos mots — l’IA l’exécute sur le fichier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe la tarea con tus palabras: la IA la hará con el archivo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi il compito con parole tue: l’IA lo eseguirà sul file"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva a tarefa com suas palavras — a IA a executa no arquivo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz zadanie własnymi słowami — AI wykona je na pliku"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを自分の言葉で書いてください — AI がファイルに対して実行します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 직접 적어 주세요 — AI가 파일에 대해 실행합니다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب المهمة بكلماتك — سينفذها الذكاء الاصطناعي على الملف"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis tugas dengan kata-kata Anda — AI mengerjakannya pada file"
          }
        }
      }
    },
