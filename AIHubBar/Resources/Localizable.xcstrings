    "Ключ выглядит неправильно: только латиница, цифры и . _ - ~ + / = :, от 8 символов": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو المفتاح غير صحيح: أحرف لاتينية وأرقام و. _ - ~ + / = : فقط، 8 محارف على الأقل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel sieht falsch aus: nur lateinische Buchstaben, Ziffern und . _ - ~ + / = :, mindestens 8 Zeichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key looks wrong: Latin letters, digits and . _ - ~ + / = : only, at least 8 characters"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave no parece correcta: solo letras latinas, cifras y . _ - ~ + / = :, al menos 8 caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé semble incorrecte : lettres latines, chiffres et . _ - ~ + / = : uniquement, au moins 8 caractères"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tampak salah: hanya huruf Latin, angka, dan . _ - ~ + / = :, minimal 8 karakter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave sembra sbagliata: solo lettere latine, cifre e . _ - ~ + / = :, almeno 8 caratteri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの形式が正しくないようです: ラテン文字、数字、. _ - ~ + / = : のみ、8 文字以上"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 형식이 잘못된 것 같습니다: 라틴 문자, 숫자, . _ - ~ + / = :만 쓸 수 있고 8자 이상이어야 합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz wygląda na błędny: tylko litery łacińskie, cyfry i . _ - ~ + / = :, co najmniej 8 znaków"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave parece errada: só letras latinas, números e . _ - ~ + / = :, no mínimo 8 caracteres"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ виглядає неправильно: лише латиниця, цифри та . _ - ~ + / = :, від 8 символів"
          }
        }
      }
    },
