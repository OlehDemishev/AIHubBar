    "Нет git-проектов: укажите папку с проектами в профиле — Настройки → «Профили».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No git projects: set the projects folder in the profile — Settings → “Profiles”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає git-проєктів: вкажіть теку з проєктами в профілі — Налаштування → «Профілі»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Git-Projekte: Legen Sie den Projektordner im Profil fest — Einstellungen → „Profile“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun projet git : indiquez le dossier des projets dans le profil — Réglages → « Profils »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay proyectos git: indica la carpeta de proyectos en el perfil — Ajustes → «Perfiles»."
          }
        },
        "it": {
