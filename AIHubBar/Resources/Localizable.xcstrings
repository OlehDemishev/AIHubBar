    "Windows прячет новые значки под «^». Чтобы AI Hub Bar был всегда виден: Параметры → Персонализация → Панель задач → Другие значки на панели задач.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي Windows الأيقونات الجديدة تحت «^». لإبقاء AI Hub Bar ظاهرًا: الإعدادات ← التخصيص ← شريط المهام ← أيقونات علبة النظام الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows versteckt neue Symbole unter „^“. Damit AI Hub Bar immer sichtbar ist: Einstellungen → Personalisierung → Taskleiste → Andere Infobereichsymbole."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows hides new icons under “^”. To keep AI Hub Bar in view: Settings → Personalization → Taskbar → Other system tray icons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows oculta los iconos nuevos bajo «^». Para tener AI Hub Bar siempre a la vista: Configuración → Personalización → Barra de tareas → Otros iconos de la bandeja del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows cache les nouvelles icônes sous « ^ ». Pour garder AI Hub Bar visible : Paramètres → Personnalisation → Barre des tâches → Autres icônes de la barre d’état système."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows menyembunyikan ikon baru di bawah “^”. Agar AI Hub Bar selalu terlihat: Pengaturan → Personalisasi → Bilah Tugas → Ikon baki sistem lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows nasconde le nuove icone sotto «^». Per tenere AI Hub Bar sempre visibile: Impostazioni → Personalizzazione → Barra delle applicazioni → Altre icone della barra delle applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows は新しいアイコンを「^」の中に隠します。AI Hub Bar を常に表示するには：設定 → 個人用設定 → タスク バー → その他のシステム トレイ アイコン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows는 새 아이콘을 “^” 아래에 숨깁니다. AI Hub Bar를 항상 보이게 하려면: 설정 → 개인 설정 → 작업 표시줄 → 기타 시스템 트레이 아이콘."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows chowa nowe ikony pod „^”. Aby AI Hub Bar był zawsze widoczny: Ustawienia → Personalizacja → Pasek zadań → Inne ikony zasobnika systemowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Windows esconde ícones novos em “^”. Para manter o AI Hub Bar visível: Configurações → Personalização → Barra de Tarefas → Outros ícones da bandeja do sistema."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows ховає нові значки під «^». Щоб AI Hub Bar завжди було видно: Параметри → Персоналізація → Панель завдань → Інші значки на панелі завдань."
          }
        }
      }
    },
