    "Нужна ⌘, ⌃ или ⌥ — или одна клавиша F1–F20.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم ⌘ أو ⌃ أو ⌥ — أو مفتاح واحد من F1–F20."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig ist ⌘, ⌃ oder ⌥ – oder eine einzelne Taste F1–F20."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs ⌘, ⌃ or ⌥ — or a single F1–F20 key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta ⌘, ⌃ u ⌥, o una sola tecla F1–F20."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut ⌘, ⌃ ou ⌥ — ou une seule touche F1–F20."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlu ⌘, ⌃, atau ⌥ — atau satu tombol F1–F20."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve ⌘, ⌃ o ⌥ — oppure un solo tasto F1–F20."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘、⌃、⌥ のいずれか、または F1〜F20 キー単体が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌃ 또는 ⌥가 필요합니다. 또는 F1–F20 키 하나만."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebny ⌘, ⌃ lub ⌥ — albo pojedynczy klawisz F1–F20."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso ⌘, ⌃ ou ⌥ — ou uma única tecla F1–F20."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібна ⌘, ⌃ або ⌥ — або одна клавіша F1–F20."
          }
        }
      }
    },
