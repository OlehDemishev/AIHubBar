    "Нужно разрешить AI Hub Bar в Системных настройках → Основные → Объекты входа.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب السماح لـ AI Hub Bar في إعدادات النظام ← عام ← عناصر تسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Hub Bar muss unter Systemeinstellungen → Allgemein → Anmeldeobjekte erlaubt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Hub Bar has to be allowed in System Settings → General → Login Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que permitir AI Hub Bar en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut autoriser AI Hub Bar dans Réglages Système → Général → Ouverture."
