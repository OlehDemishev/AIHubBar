    " Claude Code подхватывает изменения сам, в том числе в открытых сессиях.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " يطبّق Claude Code التغيير تلقائيًا، بما في ذلك في الجلسات المفتوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code übernimmt die Änderung selbst, auch in offenen Sitzungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code picks up the change by itself, including open sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code aplica el cambio por sí mismo, también en las sesiones abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code applique la modification tout seul, y compris dans les sessions ouvertes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code menerapkan perubahan sendiri, termasuk di sesi yang sedang terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code applica la modifica da solo, anche nelle sessioni aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code は開いているセッションも含め、変更を自動で反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code는 열려 있는 세션을 포함해 변경 사항을 스스로 반영합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code sam wprowadza zmianę, także w otwartych sesjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " O Claude Code aplica a mudança sozinho, inclusive nas sessões abertas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " Claude Code підхоплює зміни сам, зокрема у відкритих сесіях."
          }
        }
      }
    },
    " Продолжу после сброса в %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " سأستأنف بعد إعادة الضبط عند %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Geht nach dem Zurücksetzen um %@ weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Resuming after the reset at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Continuaré tras el reinicio a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Reprise après la réinitialisation à %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Dilanjutkan setelah reset pukul %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Riprendo dopo il reset alle %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ のリセット後に再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 초기화 후 다시 시작합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Wznowię po resecie o %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Retomo após o reinício às %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " Продовжу після скидання о %@."
          }
        }
      }
    },
