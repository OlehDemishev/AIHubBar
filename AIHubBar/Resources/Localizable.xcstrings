    "Сервис команд-шаблонов профиля (этап 4). Агенты и ключи — Настройки → «Сервисы AI».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة أوامر ملف التعريف. الوكلاء والمفاتيح — الإعدادات ← «خدمات الذكاء الاصطناعي»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst für die Befehle des Profils. Agenten und Schlüssel — Einstellungen → „KI-Dienste“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service for the profile's command templates. Agents and keys — Settings → “AI Services”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de los comandos del perfil. Agentes y claves — Ajustes → «Servicios de IA»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service des commandes du profil. Agents et clés — Réglages → «Services d'IA»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan untuk perintah profil. Agen dan kunci — Pengaturan → «Layanan AI»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio dei comandi del profilo. Agenti e chiavi — Impostazioni → «Servizi IA»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルのコマンドを実行するサービス。エージェントとキー — 設定 → 「AI サービス」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 명령에 쓰는 서비스. 에이전트와 키 — 설정 → «AI 서비스»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa dla poleceń profilu. Agenci i klucze — Ustawienia → „Usługi AI”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço dos comandos do perfil. Agentes e chaves — Ajustes → «Serviços de IA»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервіс команд профілю. Агенти й ключі — Налаштування → «Сервіси AI»."
