    "Дедлайны, публикации и контент-план на 7 дней вперёд — из профилей с календарём.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواعيد النهائية والنشر وخطة المحتوى للأيام السبعة القادمة — من ملفات التعريف ذات التقويم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen, Veröffentlichungen und der Inhaltsplan der nächsten 7 Tage — aus Profilen mit Kalender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines, publications and the content plan for the next 7 days — from profiles with the calendar on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechas límite, publicaciones y el plan de contenido de los próximos 7 días, de los perfiles con calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échéances, publications et plan de contenu des 7 prochains jours — des profils avec calendrier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenggat, publikasi, dan rencana konten 7 hari ke depan — dari profil yang kalendernya aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scadenze, pubblicazioni e piano dei contenuti dei prossimi 7 giorni — dai profili con il calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後 7 日間の締め切り、公開、コンテンツ計画 — カレンダーがオンのプロファイルから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 7일의 마감, 게시, 콘텐츠 계획 — 캘린더가 켜진 프로필에서."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy, publikacje i plan treści na 7 dni naprzód — z profili z kalendarzem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prazos, publicações e o plano de conteúdo dos próximos 7 dias — dos perfis com calendário."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дедлайни, публікації й контент-план на 7 днів уперед — з профілів із календарем."
          }
        }
      }
    },
