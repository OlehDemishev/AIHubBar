    "Не выбрана модель — Настройки → «Сервисы AI» → «Проверить»": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُختر نموذج — الإعدادات ← «خدمات الذكاء الاصطناعي» ← «تحقّق»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell gewählt — Einstellungen → „KI-Dienste“ → „Prüfen“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model chosen — Settings → “AI Services” → “Check”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay modelo elegido — Ajustes → «Servicios de IA» → «Comprobar»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle choisi — Réglages → «Services d'IA» → «Vérifier»"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada model dipilih — Pengaturan → «Layanan AI» → «Periksa»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello scelto — Impostazioni → «Servizi IA» → «Verifica»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが選ばれていません — 設定 → 「AI サービス」 → 「確認」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 고르지 않았습니다 — 설정 → «AI 서비스» → «확인»"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano modelu — Ustawienia → „Usługi AI” → „Sprawdź”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo escolhido — Ajustes → «Serviços de IA» → «Verificar»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вибрано модель — Налаштування → «Сервіси AI» → «Перевірити»"
          }
        }
      }
    },
    "Не гасить и экран": {
      "localizations": {
        "ar": {
