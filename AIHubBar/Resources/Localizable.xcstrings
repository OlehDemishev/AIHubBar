    "Не удалось прочитать %@ (%@). Файл не изменён.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة %1$@ (%2$@). لم يتغير الملف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ konnte nicht gelesen werden (%2$@). Die Datei ist unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read %1$@ (%2$@). The file is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer %1$@ (%2$@). El archivo no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire %1$@ (%2$@). Le fichier n'a pas été modifié."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membaca %1$@ (%2$@). Berkas tidak diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere %1$@ (%2$@). Il file non è cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を読み込めませんでした (%2$@)。ファイルは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 읽을 수 없습니다 (%2$@). 파일은 바뀌지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać %1$@ (%2$@). Plik nie został zmieniony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler %1$@ (%2$@). O arquivo não foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "Не удалось прочитать %1$@ (%2$@). Файл не изменён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати %1$@ (%2$@). Файл не змінено."
          }
        }
      }
    },
