    "Запросы идут через бот модуля «Telegram» — отдельный бот ниже не нужен.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests go through the “Telegram” module's bot — the separate bot below isn't needed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запити йдуть через бот модуля «Telegram» — окремий бот нижче не потрібен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen laufen über den Bot des Moduls „Telegram“ – der separate Bot unten wird nicht gebraucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes passent par le bot du module « Telegram » — le bot séparé ci-dessous n'est pas nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes van por el bot del módulo «Telegram»; el bot aparte de abajo no hace falta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste passano dal bot del modulo «Telegram»: il bot separato qui sotto non serve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos vão pelo bot do módulo “Telegram” — o bot separado abaixo não é necessário."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośby idą przez bota modułu „Telegram” — osobny bot poniżej nie jest potrzebny."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストは「Telegram」モジュールのボット経由で届きます — 下の別ボットは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청은 'Telegram' 모듈의 봇으로 갑니다 — 아래의 별도 봇은 필요 없습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمر الطلبات عبر بوت وحدة «Telegram» — لا حاجة للبوت المنفصل أدناه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan lewat bot modul “Telegram” — bot terpisah di bawah tidak diperlukan."
          }
        }
      }
    },
