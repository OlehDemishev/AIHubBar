    "Дедлайны и публикации из проект.md, записи контент-план.md — у профилей, где «Календарь» включён (Настройки → «Профили»).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواعيد النهائية والنشر من مشروع.md، وصفوف خطة-المحتوى.md — في ملفات التعريف التي فُعّل فيها «التقويم» (الإعدادات ← «ملفات التعريف»)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen und Veröffentlichungen aus projekt.md, Zeilen aus inhaltsplan.md — für Profile mit eingeschaltetem Kalender (Einstellungen → „Profile“)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines and publications from project.md, rows of content-plan.md — for profiles with the calendar on (Settings → “Profiles”)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechas límite y publicaciones de proyecto.md, filas de plan-de-contenido.md — en los perfiles con el calendario activado (Ajustes → «Perfiles»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échéances et publications de projet.md, lignes de plan-de-contenu.md — dans les profils où le calendrier est activé (Réglages → «Profils»)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenggat dan publikasi dari proyek.md, baris rencana-konten.md — di profil yang kalendernya aktif (Pengaturan → «Profil»)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scadenze e pubblicazioni da progetto.md, righe di piano-contenuti.md — per i profili con il calendario attivo (Impostazioni → «Profili»)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト.md の締め切りと公開、コンテンツ計画.md の行 — カレンダーがオンのプロファイルで (設定 → 「プロファイル」)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트.md의 마감과 게시, 콘텐츠-계획.md의 행 — 캘린더가 켜진 프로필에서 (설정 → «프로필»)."
          }
