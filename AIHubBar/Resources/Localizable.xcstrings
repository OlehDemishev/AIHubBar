    "Результат — новый файл рядом; существующие файлы не меняются.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النتيجة ملف جديد بجانبه؛ لا تتغير الملفات الموجودة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis ist eine neue Datei daneben; vorhandene Dateien bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is a new file next to it; existing files are left as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado es un archivo nuevo al lado; los existentes no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat est un nouveau fichier à côté ; les fichiers existants ne changent pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasilnya berkas baru di sebelahnya; berkas yang ada tidak diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato è un nuovo file accanto; i file esistenti non cambiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は隣に新しいファイルとして保存され、既存のファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과는 옆에 새 파일로 저장되며 기존 파일은 바뀌지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik to nowy plik obok; istniejące pliki się nie zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado é um arquivo novo ao lado; os arquivos existentes não mudam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат — новий файл поруч; наявні файли не змінюються."
          }
        }
      }
    },
