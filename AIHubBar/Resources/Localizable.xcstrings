    "Выполнить одну команду 2–3 сервисами и положить результаты рядом": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل أمر واحد بخدمتين أو ثلاث ووضع النتائج جنبًا إلى جنب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Befehl mit 2–3 Diensten ausführen und die Ergebnisse nebeneinanderlegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run one command with 2–3 services and put the results side by side"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar un comando con 2–3 servicios y poner los resultados uno al lado del otro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter une commande avec 2–3 services et placer les résultats côte à côte"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan satu perintah dengan 2–3 layanan dan letakkan hasilnya berdampingan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguire un comando con 2–3 servizi e mettere i risultati uno accanto all'altro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのコマンドを 2〜3 個のサービスで実行し、結果を並べる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 하나를 서비스 2~3개로 실행하고 결과를 나란히 놓기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonaj jedno polecenie w 2–3 usługach i połóż wyniki obok siebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar um comando com 2–3 serviços e pôr os resultados lado a lado"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконати одну команду 2–3 сервісами й покласти результати поруч"
          }
        }
      }
    },
