    "«%@» запустится в фоне в %@, после сброса лимита.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبدأ «%@» في الخلفية في %@ بعد إعادة ضبط الحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ startet um %@ im Hintergrund, nachdem das Limit zurückgesetzt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will start in the background at %@, after the limit resets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se iniciará en segundo plano a las %@, después de reiniciarse el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» démarrera en arrière-plan à %@, après la réinitialisation de la limite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» akan mulai di latar belakang pukul %@, setelah batas direset."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» partirà in background alle %@, dopo l'azzeramento del limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は制限のリセット後、%@ にバックグラウンドで開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»은(는) 한도가 초기화된 뒤 %@에 백그라운드로 시작됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” uruchomi się w tle o %@, po zresetowaniu limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» vai começar em segundo plano às %@, depois que o limite reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@» запустится в фоне в %2$@, после сброса лимита."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» запуститься у фоні о %@, після скидання ліміту."
          }
        }
      }
    },
    "«%@» запустится ночью в %@. Утром придёт сводка.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبدأ «%@» الليلة في %@. يصل ملخص في الصباح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ startet heute Nacht um %@. Morgens kommt eine Zusammenfassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» will start tonight at %@. A summary comes in the morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se iniciará esta noche a las %@. Por la mañana llegará un resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » démarrera cette nuit à %@. Un résumé arrivera le matin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» akan dimulai malam ini pukul %@. Ringkasan datang pagi hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» partirà stanotte alle %@. Al mattino arriva un riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は今夜 %@ に開始します。朝に概要が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»은(는) 오늘 밤 %@에 시작됩니다. 아침에 요약이 옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” wystartuje w nocy o %@. Rano przyjdzie podsumowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» começa esta noite às %@. De manhã chega um resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@» запустится ночью в %2$@. Утром придёт сводка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» запуститься вночі о %@. Зранку прийде зведення."
          }
        }
      }
    },
