          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz „Układ klawiatury” na stronie „Moduły”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative «Layout do teclado» na página «Módulos»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть «Розкладка» на сторінці «Модулі»."
          }
        }
      }
    },
    "Включите «Сравнить», выберите 2–3 сервиса и команду: результаты лягут рядом («хуки (Claude).md», «хуки (OpenAI).md») и откроются в окне «Сравнение».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل «قارن»، واختر خدمتين أو ثلاثًا وأمرًا: ستوضع النتائج جنبًا إلى جنب («hooks (Claude).md» و«hooks (OpenAI).md») وتُفتح في نافذة «المقارنة»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie „Vergleichen“ ein, wählen Sie 2–3 Dienste und einen Befehl: Die Ergebnisse liegen nebeneinander („hooks (Claude).md“, „hooks (OpenAI).md“) und öffnen sich im Fenster „Vergleich“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Compare”, pick 2–3 services and a command: the results land side by side (“hooks (Claude).md”, “hooks (OpenAI).md”) and open in the “Comparison” window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Comparar», elige 2–3 servicios y un comando: los resultados quedarán uno al lado del otro («ganchos (Claude).md», «ganchos (OpenAI).md») y se abrirán en la ventana «Comparación»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez «Comparer», choisissez 2–3 services et une commande : les résultats se placent côte à côte («accroches (Claude).md», «accroches (OpenAI).md») et s'ouvrent dans la fenêtre «Comparaison»."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan «Bandingkan», pilih 2–3 layanan dan satu perintah: hasilnya diletakkan berdampingan («hooks (Claude).md», «hooks (OpenAI).md») dan dibuka di jendela «Perbandingan»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva «Confronta», scegli 2–3 servizi e un comando: i risultati finiscono uno accanto all'altro («hook (Claude).md», «hook (OpenAI).md») e si aprono nella finestra «Confronto»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「比較」をオンにし、2〜3 個のサービスとコマンドを選びます: 結果は並べて保存され (「hooks (Claude).md」、「hooks (OpenAI).md」)、「比較」ウィンドウで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«비교»를 켜고 서비스 2~3개와 명령을 고르세요: 결과가 나란히 저장되고 («hooks (Claude).md», «hooks (OpenAI).md») «비교» 창에서 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz „Porównaj”, wybierz 2–3 usługi i polecenie: wyniki trafią obok siebie („hooks (Claude).md”, „hooks (OpenAI).md”) i otworzą się w oknie „Porównanie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative «Comparar», escolha 2–3 serviços e um comando: os resultados ficam lado a lado («ganchos (Claude).md», «ganchos (OpenAI).md») e abrem na janela «Comparação»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть «Порівняти», виберіть 2–3 сервіси й команду: результати ляжуть поруч («хуки (Claude).md», «хуки (OpenAI).md») і відкриються у вікні «Порівняння»."
          }
        }
      }
    },
    "Включите календарь в профиле — или кнопкой «Включить в профиле» на плитке «Ближайшее».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل التقويم في ملف التعريف — أو بزر «التفعيل في ملف التعريف» في بطاقة «القريب»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie den Kalender im Profil — oder mit der Taste „Im Profil einschalten“ auf der Kachel „Demnächst“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the calendar in the profile — or use the “Turn on in the profile” button on the “Upcoming” tile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el calendario en el perfil — o con el botón «Activar en el perfil» en el mosaico «Próximo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le calendrier dans le profil — ou avec le bouton « Activer dans le profil » sur la tuile « À venir »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan kalender di profil — atau lewat tombol «Aktifkan di profil» pada ubin «Mendatang»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il calendario nel profilo — oppure con il pulsante «Attiva nel profilo» sul riquadro «In arrivo»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルでカレンダーをオンにします。「今後の予定」タイルの「プロファイルでオンにする」ボタンからもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필에서 캘린더를 켜세요. «다가오는 일정» 타일의 «프로필에서 켜기» 버튼으로도 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz kalendarz w profilu — albo przyciskiem „Włącz w profilu” na kafelku „Najbliższe”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o calendário no perfil — ou pelo botão «Ativar no perfil» no bloco «Próximos»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть календар у профілі — або кнопкою «Увімкнути в профілі» на плитці «Найближче»."
          }
        }
      }
    },
    "Включите отслеживание на странице «Сессии агентов».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل التتبّع في صفحة «جلسات الوكلاء»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die Erfassung auf der Seite „Agentensitzungen“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on tracking on the “Agent sessions” page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el seguimiento en la página «Sesiones de agentes»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le suivi sur la page « Sessions des agents »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan pelacakan di halaman “Sesi agen”."
          }
        },
        "it": {
