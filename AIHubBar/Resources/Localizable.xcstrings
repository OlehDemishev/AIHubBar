            "value": "最初のプロファイルとともに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 프로필과 함께 나타납니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawi się z pierwszym profilem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece com o primeiro perfil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’явиться разом із першим профілем."
          }
        }
      }
    },
    "Появится, когда у профиля есть источник проектов — «Профили» → профиль.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر عندما يكون لملف التعريف مصدر مشاريع — «ملفات التعريف» ← ملف التعريف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint, wenn ein Profil eine Projektquelle hat – „Profile“ → Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears when a profile has a project source — “Profiles” → profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerá cuando un perfil tenga una fuente de proyectos: «Perfiles» → perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaît quand un profil a une source de projets — « Profils » → profil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muncul saat profil punya sumber proyek — «Profil» → profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparirà quando un profilo ha una fonte di progetti — «Profili» → profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルにプロジェクトのソースがあるときに表示されます —「プロファイル」→ プロファイル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필에 프로젝트 소스가 있으면 나타납니다 — «프로필» → 프로필."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawi się, gdy profil ma źródło projektów — „Profile” → profil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece quando um perfil tem uma fonte de projetos — «Perfis» → perfil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’явиться, коли профіль має джерело проєктів — «Профілі» → профіль."
          }
        }
      }
    },
    "Появится, когда у профиля команды _daily-report — «Профили» → профиль.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر عندما تكون لملف التعريف أوامر _daily-report — «ملفات التعريف» ← ملف التعريف."
          }
        },
        "de": {
          "stringUnit": {
