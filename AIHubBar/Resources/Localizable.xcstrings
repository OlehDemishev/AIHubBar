    "Прислать 🏠 с новым меню; иначе оно обновится при следующем нажатии 🏠": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send 🏠 with the new menu; otherwise it updates the next time you press 🏠"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати 🏠 з новим меню; інакше воно оновиться при наступному натисканні 🏠"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "🏠 mit dem neuen Menü senden; sonst wird es beim nächsten Tippen auf 🏠 aktualisiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer 🏠 avec le nouveau menu ; sinon il se met à jour au prochain 🏠"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar 🏠 con el nuevo menú; si no, se actualizará la próxima vez que pulses 🏠"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia 🏠 con il nuovo menu; altrimenti si aggiorna al prossimo 🏠"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar 🏠 com o novo menu; senão ele atualiza no próximo toque em 🏠"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij 🏠 z nowym menu; inaczej zaktualizuje się przy następnym naciśnięciu 🏠"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメニュー付きの 🏠 を送ります。送らない場合は次に 🏠 を押したときに更新されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 메뉴와 함께 🏠을 보냅니다. 아니면 다음에 🏠을 누를 때 업데이트됩니다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال 🏠 بالقائمة الجديدة؛ وإلا فستتحدّث عند الضغط التالي على 🏠"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim 🏠 dengan menu baru; jika tidak, menu diperbarui saat 🏠 ditekan berikutnya"
          }
        }
      }
    },
