          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть «Острів біля виїмки» на сторінці «Модулі»."
          }
        }
      }
    },
    "Включите «Раскладку» на странице «Модули».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل «تخطيط لوحة المفاتيح» في صفحة «الوحدات»."
          }
        },
