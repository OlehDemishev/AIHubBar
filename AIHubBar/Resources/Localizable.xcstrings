    "В этой папке уже работает сессия Claude. Запустить ещё одну там же?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل جلسة Claude بالفعل في هذا المجلد. هل تبدأ أخرى في المكان نفسه؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Ordner arbeitet schon eine Claude-Sitzung. Dort eine weitere starten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Claude session already works in this folder. Start another one there?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una sesión de Claude trabajando en esta carpeta. ¿Iniciar otra en el mismo sitio?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session Claude travaille déjà dans ce dossier. En lancer une autre au même endroit ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah ada sesi Claude yang bekerja di folder ini. Mulai satu lagi di sana?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa cartella lavora già una sessione di Claude. Avviarne un'altra lì?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダーではすでに Claude のセッションが作業中です。同じ場所でもう 1 つ開始しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에서 이미 Claude 세션이 작업 중입니다. 같은 곳에서 하나 더 시작할까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym folderze już pracuje sesja Claude. Uruchomić tam kolejną?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já há uma sessão do Claude trabalhando nesta pasta. Iniciar outra no mesmo lugar?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цій папці вже працює сесія Claude. Запустити ще одну там само?"
          }
        }
      }
    },
