    "Скопировать токен и чат из _daily-report/config.json в связку ключей": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the token and chat from _daily-report/config.json into the Keychain"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіювати токен і чат із _daily-report/config.json у в'язку ключів"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token und Chat aus _daily-report/config.json in den Schlüsselbund kopieren"
          }
        },
        "fr": {
          "stringUnit": {
