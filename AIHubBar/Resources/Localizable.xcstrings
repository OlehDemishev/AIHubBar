    "Чёрный остров вокруг чёлки MacBook: запросы, события и по наведению карточка с лимитами и тем, что делает Claude.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزيرة سوداء حول نتوء MacBook: الطلبات والأحداث، وعند التمرير بطاقة بالحدود وبما يفعله Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine schwarze Insel um die Notch des MacBook: Anfragen, Ereignisse und beim Darüberfahren eine Karte mit Limits und dem, was Claude gerade tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A black island around the MacBook notch: requests, events and, on hover, a card with limits and what Claude is doing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una isla negra alrededor del notch del MacBook: solicitudes, eventos y, al pasar el cursor, una tarjeta con los límites y lo que está haciendo Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une île noire autour de l’encoche du MacBook : demandes, événements et, au survol, une carte avec les limites et ce que fait Claude."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulau hitam di sekitar notch MacBook: permintaan, peristiwa, dan saat kursor diarahkan, kartu berisi batas dan apa yang sedang dikerjakan Claude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’isola nera intorno al notch del MacBook: richieste, eventi e, passandoci sopra, una scheda con i limiti e ciò che sta facendo Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook のノッチを囲む黒いアイランド:リクエスト、イベント、ポインタを合わせると上限と Claude の作業内容をカードで表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook 노치를 둘러싼 검은 아일랜드: 요청, 이벤트, 포인터를 올리면 한도와 Claude가 하고 있는 일을 카드로 보여 줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czarna wyspa wokół notcha MacBooka: prośby, zdarzenia i po najechaniu karta z limitami i tym, co robi Claude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ilha preta ao redor do notch do MacBook: pedidos, eventos e, ao passar o cursor, um cartão com os limites e o que o Claude está fazendo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чорний острів навколо виїмки MacBook: запити, події та при наведенні картка з лімітами й тим, що робить Claude."
          }
        }
      }
    },
    "Запросы и лимиты у чёлки": {
      "localizations": {
        "ar": {
          "stringUnit": {
