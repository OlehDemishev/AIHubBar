      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظات Markdown داخل اللوحة: علامات تبويب لملفات .md عادية في مجلد يفتحه أي محرر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown-Notizen direkt im Panel: Tabs über normale .md-Dateien in einem Ordner, den jeder Editor öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown notes right in the panel: tabs over plain .md files in a folder any editor can open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas en Markdown en el panel: pestañas sobre archivos .md normales en una carpeta que abre cualquier editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des notes Markdown dans le panneau : des onglets sur de simples fichiers .md dans un dossier que tout éditeur ouvre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan Markdown langsung di panel: tab untuk file .md biasa di folder yang bisa dibuka editor apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note in Markdown nel pannello: schede su normali file .md in una cartella che qualsiasi editor apre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルで Markdown メモ: どのエディタでも開けるフォルダ内の普通の .md ファイルをタブで扱います。"
          }
        },
        "ko": {
          "stringUnit": {
