    " Нет на этом Mac: %@ — после импорта выберите свои папки.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " غير موجود على هذا الـ Mac: %@ — اختر مجلداتك بعد الاستيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Nicht auf diesem Mac: %@ — wählen Sie nach dem Import eigene Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Not on this Mac: %@ — choose your own folders after the import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " No están en este Mac: %@ — elige tus propias carpetas después de importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Absent sur ce Mac : %@ — choisissez vos propres dossiers après l'import."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Tidak ada di Mac ini: %@ — pilih folder Anda sendiri setelah impor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
