    "Другие AI подключаются в «Сервисы AI»: вход в их CLI или ключ API.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُربط خدمات الذكاء الاصطناعي الأخرى في «خدمات الذكاء الاصطناعي»: بتسجيل الدخول إلى CLI الخاصة بها أو بمفتاح API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere KIs verbinden Sie unter „KI-Dienste“: per Anmeldung in ihrer CLI oder mit einem API-Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other AIs are connected in “AI Services”: sign in to their CLI or add an API key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las otras IA se conectan en «Servicios de IA»: con el inicio de sesión en su CLI o una clave de API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres IA se connectent dans « Services d'IA » : connexion à leur CLI ou clé d’API."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI lain dihubungkan di «Layanan AI»: masuk ke CLI-nya atau dengan kunci API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le altre IA si collegano in «Servizi IA»: accesso alla loro CLI o chiave API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの AI は「AI サービス」で接続します: CLI へのサインインまたは API キー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 AI는 «AI 서비스»에서 연결합니다: CLI 로그인 또는 API 키."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne AI podłącza się w sekcji „Usługi AI”: logowanie w ich CLI albo klucz API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras IAs se conectam em «Serviços de IA»: login na CLI delas ou chave de API."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші AI підключаються в розділі «Сервіси AI»: вхід у їхній CLI або ключ API."
          }
        }
      }
    },
