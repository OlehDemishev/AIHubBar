    "Найдено: %@. Лимиты подписки и список сессий работают только с Claude Code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على: %@. حدود الاشتراك وقائمة الجلسات تعمل مع Claude Code فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefunden: %@. Abo-Limits und die Sitzungsliste funktionieren nur mit Claude Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found: %@. Subscription limits and the session list work only with Claude Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrado: %@. Los límites de la suscripción y la lista de sesiones solo funcionan con Claude Code."
