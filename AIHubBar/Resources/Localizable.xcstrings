    "Идеи и ошибки — в задачи проекта на GitHub. Форма откроется с уже заполненными версией и macOS.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأفكار والأخطاء تُرسل إلى مشكلات المشروع على GitHub. يُفتح النموذج وفيه الإصدار وmacOS معبّآن مسبقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideen und Fehler kommen in die Issues des Projekts auf GitHub. Das Formular öffnet sich mit bereits eingetragener Version und macOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas and bugs go to the project’s issues on GitHub. The form opens with the version and macOS already filled in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ideas y los errores van a las incidencias del proyecto en GitHub. El formulario se abre con la versión y macOS ya rellenados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les idées et les bugs vont dans les tickets du projet sur GitHub. Le formulaire s’ouvre avec la version et macOS déjà remplis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide dan bug masuk ke issue proyek di GitHub. Formulir terbuka dengan versi dan macOS yang sudah terisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Idee e bug vanno nelle issue del progetto su GitHub. Il modulo si apre con versione e macOS già compilati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデアや不具合は GitHub のプロジェクトの Issue へ。フォームはバージョンと macOS が入力済みの状態で開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이디어와 버그는 GitHub의 프로젝트 이슈로 보내 주세요. 양식은 버전과 macOS가 미리 채워진 상태로 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomysły i błędy trafiają do zgłoszeń projektu na GitHubie. Formularz otworzy się z już wpisaną wersją i macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideias e erros vão para as issues do projeto no GitHub. O formulário abre com a versão e o macOS já preenchidos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідеї та помилки — у задачі проєкту на GitHub. Форма відкриється з уже заповненими версією та macOS."
          }
        }
      }
    },
