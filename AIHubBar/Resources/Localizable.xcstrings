    "Скрипт в фоне": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سكربت في الخلفية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skript im Hintergrund"
          }
        },
        "en": {
          "stringUnit": {
