    "Токен сохранён. Напишите боту любое сообщение и нажмите «Определить».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ الرمز. أرسل أي رسالة إلى البوت واضغط «اكتشاف»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token gespeichert. Schreiben Sie dem Bot eine Nachricht und klicken Sie „Ermitteln“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token saved. Send the bot any message and press «Detect»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Token guardado. Envía cualquier mensaje al bot y pulsa «Detectar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton enregistré. Envoyez un message au bot et cliquez sur « Détecter »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token tersimpan. Kirim pesan apa saja ke bot dan tekan «Deteksi»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token salvato. Invia un messaggio al bot e premi «Rileva»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンを保存しました。ボットに何か送ってから「検出」を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰을 저장했습니다. 봇에 아무 메시지나 보내고 «감지»를 누르세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Token zapisany. Napisz do bota dowolną wiadomość i kliknij «Wykryj»."
          }
        },
        "pt-BR": {
          "stringUnit": {
