    "Наведите курсор на чёлку — откроется карточка с лимитами и тем, что делает Claude.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر المؤشر فوق النتوء لتُفتح بطاقة بالحدود وبما يفعله Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie den Zeiger auf die Notch — es öffnet sich eine Karte mit Limits und dem, was Claude gerade tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover over the notch to open a card with limits and what Claude is doing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el puntero por el notch y se abrirá una tarjeta con los límites y lo que hace Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez l’encoche avec le pointeur : une carte s’ouvre avec les limites et ce que fait Claude."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan kursor ke notch — kartu berisi batas dan apa yang dikerjakan Claude akan terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa il puntatore sul notch: si apre una scheda con i limiti e cosa sta facendo Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチにポインタを合わせると、制限と Claude の作業内容を示すカードが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 포인터를 올리면 한도와 Claude가 하는 일을 보여 주는 카드가 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najedź kursorem na notch — otworzy się karta z limitami i tym, co robi Claude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o ponteiro sobre o notch para abrir um cartão com os limites e o que o Claude está fazendo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть курсор на виїмку — відкриється картка з лімітами й тим, що робить Claude."
          }
        }
      }
    },
    "Нажмите и введите сочетание; Escape — отменить": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ثم أدخل الاختصار؛ Escape للإلغاء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken und dann den Kurzbefehl eingeben; Escape bricht ab"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press, then type the shortcut; Escape cancels"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa y escribe el atajo; Escape cancela"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez, puis tapez le raccourci ; Échap annule"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lalu ketik pintasan; Escape membatalkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi e digita la scorciatoia; Esc annulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押してからショートカットを入力。Escape でキャンセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누른 다음 단축키를 입력하세요. Escape로 취소"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij i wpisz skrót; Escape anuluje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione e digite o atalho; Escape cancela"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і введіть сполучення; Escape — скасувати"
          }
        }
      }
    },
