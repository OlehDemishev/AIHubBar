    "Элементы между «Новыми группами» рисуются на общей скруглённой подложке.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسم العناصر الواقعة بين فواصل «مجموعة جديدة» على خلفية مشتركة مستديرة الحواف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemente zwischen „Neue Gruppe“ werden auf einem gemeinsamen abgerundeten Hintergrund dargestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items between “New group” dividers are drawn on a shared rounded backing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos entre «Nuevo grupo» se dibujan sobre un fondo redondeado común."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments entre les « Nouveau groupe » sont dessinés sur un fond arrondi commun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemen di antara «Grup baru» digambar di atas latar bersama yang membulat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi tra «Nuovo gruppo» sono disegnati su uno sfondo arrotondato comune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「新しいグループ」の間の項目は、共通の角丸の背景にまとめて表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«새 그룹» 사이의 항목은 공통의 둥근 배경 위에 그려집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy między „Nowa grupa” są rysowane na wspólnym zaokrąglonym tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens entre «Novo grupo» são desenhados sobre um fundo arredondado comum."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елементи між розділювачами «Нова група» малюються на спільній заокругленій підкладці."
          }
        }
      }
    },
    "Элементы модуля в строке меню; порядок и вид — «Строка меню»": {
      "localizations": {
        "ar": {
          "stringUnit": {
