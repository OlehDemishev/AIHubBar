    "Добавляются командой claude mcp add или файлом .mcp.json в проекте.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف بالأمر claude mcp add أو بملف ‎.mcp.json‎ في المشروع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden mit claude mcp add oder einer .mcp.json im Projekt hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added with claude mcp add or a .mcp.json file in the project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añaden con claude mcp add o un archivo .mcp.json en el proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils s'ajoutent avec claude mcp add ou un fichier .mcp.json dans le projet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditambahkan dengan claude mcp add atau file .mcp.json di proyek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aggiungono con claude mcp add o un file .mcp.json nel progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "claude mcp add か、プロジェクトの .mcp.json で追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
