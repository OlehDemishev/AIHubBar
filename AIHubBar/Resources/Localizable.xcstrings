    "Включите «Бета-версии» в «Основных», затем «Раскладку» на странице «Модули».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل «الإصدارات التجريبية» في «عام»، ثم «تخطيط لوحة المفاتيح» في صفحة «الوحدات»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie „Beta-Versionen“ unter „Allgemein“, dann „Tastaturlayout“ auf der Seite „Module“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Beta Builds” in “General”, then “Keyboard Layout” on the “Modules” page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Versiones beta» en «General» y luego «Distribución del teclado» en la página «Módulos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Versions bêta » dans « Général », puis « Disposition du clavier » sur la page « Modules »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan «Versi beta» di «Umum», lalu «Tata letak keyboard» di halaman «Modul»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva «Versioni beta» in «Generali», poi «Layout tastiera» nella pagina «Moduli»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「一般」で「ベータ版」をオンにし、次に「モジュール」ページで「キーボード配列」をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«일반»에서 «베타 버전»을 켠 다음 «모듈» 페이지에서 «키보드 배열»을 켜세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz „Wersje beta” w sekcji „Ogólne”, potem „Układ klawiatury” na stronie „Moduły”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative «Versões beta» em «Geral» e depois «Layout do teclado» na página «Módulos»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть «Бета-версії» в розділі «Загальні», потім «Розкладка» на сторінці «Модулі»."
          }
        }
      }
    },
    "Включите «Остров у чёлки» на странице «Модули».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل «جزيرة النتوء» في صفحة «الوحدات»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie „Notch-Insel“ auf der Seite „Module“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Notch Island” on the “Modules” page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Isla del notch» en la página «Módulos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Île de l’encoche » sur la page « Modules »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan «Pulau notch» di halaman «Modul»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva «Isola del notch» nella pagina «Moduli»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モジュール」ページで「ノッチアイランド」をオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«모듈» 페이지에서 «노치 아일랜드»를 켜세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz „Wyspa przy notchu” na stronie „Moduły”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
