    },
    "Переводит последнее слово или отменяет неверное исправление — и запоминает слово.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل آخر كلمة أو يتراجع عن تصحيح خاطئ — ويتذكّر الكلمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt das letzte Wort um oder macht eine falsche Korrektur rückgängig — und merkt sich das Wort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converts the last word or undoes a wrong correction — and remembers the word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte la última palabra o deshace una corrección equivocada — y recuerda la palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertit le dernier mot ou annule une correction erronée — et retient le mot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah kata terakhir atau membatalkan koreksi yang salah — dan mengingat kata itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Converte l’ultima parola o annulla una correzione sbagliata — e memorizza la parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の単語を変換するか、誤った修正を取り消し、その単語を覚えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 단어를 변환하거나 잘못된 수정을 되돌리고, 그 단어를 기억합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisuje ostatnie słowo lub cofa błędną poprawkę — i zapamiętuje słowo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converte a última palavra ou desfaz uma correção errada — e memoriza a palavra."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводить останнє слово в іншу розкладку або скасовує хибне виправлення — і запам’ятовує слово."
          }
        }
      }
    },
