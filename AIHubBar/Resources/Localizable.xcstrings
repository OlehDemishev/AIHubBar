    "Какие блоки показывать и в каком порядке — на странице «Панель».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتل وترتيبها: صفحة «اللوحة»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blöcke und ihre Reihenfolge: Seite „Panel“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which blocks show and in what order is on the “Panel” page."
          }
        },
        "es": {
