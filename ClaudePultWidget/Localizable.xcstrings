    "Не давать Mac засыпать, пока не выключите.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء Mac مستيقظًا حتى توقفه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac wach halten, bis Sie es ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the Mac awake until you turn it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el Mac despierto hasta que lo desactives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le Mac éveillé jusqu’à ce que vous désactiviez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga Mac tetap menyala sampai Anda mematikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni sveglio il Mac finché non lo disattivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするまで Mac をスリープさせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌 때까지 Mac이 잠자지 않게 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie usypiaj Maca, dopóki nie wyłączysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter o Mac acordado até você desligar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давати Mac засинати, доки не вимкнете."
          }
        }
      }
    },
