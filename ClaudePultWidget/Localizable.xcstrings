    "Mac засыпает как обычно": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدخل الـMac في السكون كالمعتاد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac schläft wie gewohnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac sleeps as usual"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac duerme como siempre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac se met en veille normalement"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tidur seperti biasa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac va in stop come al solito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac は通常どおりスリープします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac은 평소처럼 잠자기합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac usypia jak zwykle"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac dorme como sempre"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac засинає як зазвичай"
          }
        }
      }
    },
